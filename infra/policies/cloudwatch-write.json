{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteFlowinLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:${region}:${account_id}:log-group:/flowin/${environment}/*"
    },
    {
      "Sid": "DescribeLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "arn:aws:logs:${region}:${account_id}:log-group:/flowin/${environment}*"
    }
  ]
}
