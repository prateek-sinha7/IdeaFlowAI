{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteBackupObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "${bucket_arn}/postgres/*",
        "${bucket_arn}/skills/*"
      ]
    }
  ]
}
