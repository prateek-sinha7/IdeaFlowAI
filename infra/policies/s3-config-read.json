{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadFlowinConfigObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "${bucket_arn}/config/*"
      ]
    },
    {
      "Sid": "ListFlowinConfigPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "${bucket_arn}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "config/*"
        }
      }
    }
  ]
}
