{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBedrockInvokeAllowedModels",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ConverseStream"
      ],
      "Resource": ${invoke_resources},
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ${allowed_request_regions}
        }
      }
    },
    {
      "Sid": "AllowBedrockReadInferenceProfiles",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetInferenceProfile"
      ],
      "Resource": ${inference_profile_arns},
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ${allowed_request_regions}
        }
      }
    }
  ]
}
