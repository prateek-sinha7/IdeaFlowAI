{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ParameterStoreRead",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:${partition}:ssm:${region}:${account_id}:parameter/velocityai/${environment}",
        "arn:${partition}:ssm:${region}:${account_id}:parameter/velocityai/${environment}/*"
      ]
    }
  ]
}
