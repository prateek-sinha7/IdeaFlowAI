# VelocityAI Terraform-state bootstrap — example variable values.
#
# Copy this to `bootstrap.tfvars` (git-ignored) and edit, then apply with
#   terraform apply -var-file=bootstrap.tfvars
#
# This stack runs ONCE per account to create:
#   - the S3 bucket that holds Terraform state for the shared/foundation/app layers
#   - the DynamoDB table for state locking
#   - a small bootstrap-local KMS CMK that encrypts both of the above
#   - (optionally) the per-environment GitLab CI/CD CodeBuild runners
#
# After `terraform apply` here, copy the bucket name into the layer init via
#   terraform init -backend-config="bucket=<state_bucket_name>" ...
# (see infra/terraform/{shared,foundation,app}/backend.tf for the full set).

# =============================================================================
# Core: account, region, naming, tags
# =============================================================================

# AWS account this stack runs against.
#   - Leave blank / omit  -> auto-adopt the account the AWS CLI / Terraform
#     provider is currently authenticated to (live `aws sts get-caller-identity`).
#   - Set to a 12-digit id -> the guard ABORTS plan/apply on any mismatch.
# Recommended to pin explicitly in shared / multi-account org setups.
# expected_account_id = "123456789012"

# Region. Default is eu-central-1 — change only if your stack runs elsewhere.
# aws_region = "eu-central-1"

# Globally-unique S3 bucket name for Terraform state. Convention:
# velocityai-tfstate-<region> (no account id). S3 bucket names are globally
# unique across ALL AWS accounts, so pick something unlikely to collide.
# Must be 3-63 chars. The bucket has prevent_destroy = true once created.
state_bucket_name = "velocityai-tfstate-eu-central-1"

# DynamoDB lock table. Default is fine for most deployments.
# lock_table_name = "velocityai-tfstate-locks"

# Tag values for Cost Explorer / Billing breakdowns. Defaults are "velocityai"
# — fine for single-team accounts. Override for multi-team accounts where you
# want per-team cost allocation (e.g. by org finance code).
# owner       = "velocityai-platform-team@hexaware.com"
# cost_center = "UKI-AI-001"

# =============================================================================
# CI/CD runners (optional) — see cicd.tf for the full design notes.
#
# Leave create_gitlab_runner = false (the default) for a state-backend-only
# bootstrap. Set it to true and fill in gitlab_repo_url + runners to also
# provision the per-environment CodeBuild pipeline runners.
# =============================================================================

# Master switch for the GitLab connection + per-env CodeBuild projects.
# create_gitlab_runner = false

# HTTPS clone URL of the GitLab repo (must end in .git). Required when
# create_gitlab_runner = true; ignored otherwise.
# gitlab_repo_url = "https://gitlab.com/hexaware-uki/velocityai.git"

# Optional IAM permissions-boundary ARN attached to every per-env CodeBuild
# deploy role. RECOMMENDED in a shared account: scope it to velocityai-* so the
# broad ProvisionStack statement cannot touch non-project resources.
# Empty = no boundary.
# deploy_permissions_boundary_arn = "arn:aws:iam::123456789012:policy/velocityai-deploy-boundary"

# Per-environment runner definitions, keyed by env name (dev|stage|prod). Each
# entry creates one isolated CodeBuild runner + deploy role + webhook + log
# group. Only needed when create_gitlab_runner = true.
#
# cors_origins NOTE: this is injected as TF_VAR_cors_origins and MUST be either
#   - ""                  -> backend falls back to ["https://<FQDN>"] (correct
#                            for nip.io dev/stage where the FQDN = <eip>.nip.io
#                            and isn't known until apply), or
#   - a JSON ARRAY STRING -> e.g. "[\"https://app.example.com\"]" (prod with a
#                            real Route 53 domain). Frontend + backend share one
#                            nginx origin, so usually a single entry.
# A bare "https://..." (not a JSON array) FAILS foundation validation.
#
# bedrock_model_id vs bedrock_inference_profile_id — these are DIFFERENT ids:
#   - bedrock_model_id             = the BARE foundation-model id (no regional
#                                    prefix). Scopes the IAM `foundation-model/*`
#                                    ARN, so it MUST match the model actually
#                                    invoked underneath the profile.
#   - bedrock_inference_profile_id = the CROSS-REGION inference profile id (the
#                                    `eu.` prefix) the app invokes; scopes the
#                                    IAM `inference-profile/*` ARN.
# Do NOT set bedrock_model_id to the `eu.` value — a cross-region InvokeModel
# resolves to the bare foundation-model ARN in the routed region, so a prefixed
# model id makes IAM deny bedrock:InvokeModel and every LLM call fails.
# runners = {
#   dev = {
#     branch                       = "dev"
#     cors_origins                 = ""   # nip.io -> FQDN fallback
#     bedrock_model_id             = "anthropic.claude-haiku-4-5-20251001-v1:0"
#     bedrock_inference_profile_id = "eu.anthropic.claude-haiku-4-5-20251001-v1:0"
#     alert_email                  = "velocityai-dev-alerts@hexaware.com"
#     # Optional knobs (defaults shown):
#     # compute_type       = "BUILD_GENERAL1_MEDIUM"
#     # log_retention_days = 30
#     # trigger_type       = "branch"   # "branch" | "tag" | "release"
#     # tag_pattern        = ""          # only used when trigger_type = "tag"
#     # extra_env          = {}          # extra build env vars, e.g. { FOO = "bar" }
#   }
#   stage = {
#     branch                       = "staging"
#     cors_origins                 = ""   # nip.io -> FQDN fallback
#     bedrock_model_id             = "anthropic.claude-haiku-4-5-20251001-v1:0"
#     bedrock_inference_profile_id = "eu.anthropic.claude-haiku-4-5-20251001-v1:0"
#     alert_email                  = "velocityai-stage-alerts@hexaware.com"
#   }
#   prod = {
#     branch                       = "main"
#     cors_origins                 = "[\"https://velocityai.example.com\"]"  # real domain
#     bedrock_model_id             = "anthropic.claude-haiku-4-5-20251001-v1:0"
#     bedrock_inference_profile_id = "eu.anthropic.claude-haiku-4-5-20251001-v1:0"
#     alert_email                  = "velocityai-prod-alerts@hexaware.com"
#     compute_type                 = "BUILD_GENERAL1_LARGE"
#     trigger_type                 = "release"
#   }
# }
