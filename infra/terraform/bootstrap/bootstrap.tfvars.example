# VelocityAI Terraform-state bootstrap — example variable values.
#
# Copy this to `bootstrap.tfvars` (git-ignored) and edit, then apply with
#   terraform apply -var-file=bootstrap.tfvars
#
# This stack runs ONCE per account to create:
#   - the S3 bucket that holds Terraform state for the shared/foundation/app layers
#   - the DynamoDB table for state locking
#   - a small bootstrap-local KMS CMK that encrypts both of the above
#   - (optionally) the GitHub Actions OIDC provider + shared deploy role
#
# After `terraform apply` here, copy the bucket name into the layer init via
#   terraform init -backend-config="bucket=<state_bucket_name>" ...
# (see infra/terraform/{shared,foundation,app}/backend.tf for the full set).

# =============================================================================
# Core: account, region, naming, tags
# =============================================================================

# AWS account this stack runs against.
#   - Leave blank / omit  -> auto-adopt the account the AWS CLI / Terraform
#     provider is currently authenticated to (live `aws sts get-caller-identity`).
#   - Set to a 12-digit id -> the guard ABORTS plan/apply on any mismatch.
# Recommended to pin explicitly in shared / multi-account org setups.
# expected_account_id = "123456789012"

# Region. Default is eu-central-1 — change only if your stack runs elsewhere.
# aws_region = "eu-central-1"

# Globally-unique S3 bucket name for Terraform state. Convention:
# velocityai-tfstate-<region> (no account id). S3 bucket names are globally
# unique across ALL AWS accounts, so pick something unlikely to collide.
# Must be 3-63 chars. The bucket has prevent_destroy = true once created.
state_bucket_name = "velocityai-tfstate-eu-central-1"

# DynamoDB lock table. Default is fine for most deployments.
# lock_table_name = "velocityai-tfstate-locks"

# Tag values for Cost Explorer / Billing breakdowns. Defaults are "velocityai"
# — fine for single-team accounts. Override for multi-team accounts where you
# want per-team cost allocation (e.g. by org finance code).
# owner       = "velocityai-platform-team@hexaware.com"
# cost_center = "UKI-AI-001"

# =============================================================================
# GitHub Actions CI/CD (optional) — see github_oidc.tf for the full design
# notes, and docs/GITHUB_CICD_SETUP.md for the complete operator guide.
#
# Leave create_github_oidc = false (the default) for a state-backend-only
# bootstrap. Set it to true and fill in github_org_repo to also provision the
# OIDC identity provider, ONE ECR-only build role, and ONE DEPLOY ROLE PER
# ENVIRONMENT (each trusting a single OIDC subject — see github_oidc.tf for why
# a single shared role cannot isolate environments).
# =============================================================================

# Master switch for the OIDC provider + build/deploy roles.
# create_github_oidc = false

# EXACT GitHub "<owner>/<repository>". Required when create_github_oidc = true.
# WILDCARDS ARE REJECTED by variable validation: a glob such as
# "my-org*/my-repo*" would also admit any other owner/repository sharing that
# prefix, in any organisation — a repo-impersonation path into this account.
# An org/repo rename is a deliberate change here plus a re-apply.
# github_org_repo = "my-org/velocityai"

# GitHub Environment names. ONE DEPLOY ROLE IS CREATED PER ENTRY, each scoped to
# only its own /velocityai/<env>/* parameters and only instances tagged
# Environment=<env>. Default matches the live infra's short names (dev/stage/prod
# — NOT dev/staging/production; see docs/GITHUB_CICD_SETUP.md's naming callout).
# github_environments = ["dev", "stage", "prod"]

# Adopt an existing token.actions.githubusercontent.com OIDC provider instead
# of creating one. There can be only one per account for a given URL — set
# false if a sibling project in this shared account already created it.
# github_oidc_create_provider = true

# Optional IAM permissions-boundary ARN attached to EVERY role created here
# (build + each per-env deploy role). RECOMMENDED in a shared account: scope it
# to velocityai-* so these roles cannot touch non-project resources. Empty = no
# boundary, which github_oidc.tf reports as a plan/apply WARNING (check block)
# rather than failing — so a first bootstrap in a sandbox account still works.
# deploy_permissions_boundary_arn = "arn:aws:iam::123456789012:policy/velocityai-deploy-boundary"

# Optional: pin the KMS keys the deploy roles may encrypt SecureStrings with.
# Empty (default) allows any key in this account+region, but ONLY via SSM and
# ONLY for the role's own /velocityai/<env>/* parameters (kms:ViaService +
# kms:EncryptionContext:PARAMETER_ARN conditions). Supply the per-env project
# CMK ARNs once the foundation layer has created them to tighten further.
# github_cicd_kms_key_arns = ["arn:aws:kms:eu-central-1:123456789012:key/<id>"]
