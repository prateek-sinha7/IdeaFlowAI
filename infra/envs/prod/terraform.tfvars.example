# Flowin prod environment — example variable values.
#
# Copy this to `terraform.tfvars` (which is git-ignored) and edit. Values that
# carry secrets should ideally come from environment variables (TF_VAR_<name>)
# rather than this file.

# ---- Identity guard --------------------------------------------------------

# 12-digit AWS account ID this stack must run against. Mismatch aborts.
expected_account_id = "123456789012"

# Region. The guard rejects anything else.
aws_region        = "eu-central-1"
availability_zone = "eu-central-1a"

# Friendly name; used in name_prefix (= flowin-${environment}) and in the
# /flowin/${environment}/... parameter paths.
environment = "prod"

# ---- Tagging ---------------------------------------------------------------

owner       = "flowin-platform-team@hexaware.com"
cost_center = "UKI-FLOWIN-PROD"

# ---- Optional cross-account assume-role ------------------------------------

# Leave empty unless your CI assumes a role in the Flowin account.
# assume_role_arn         = "arn:aws:iam::123456789012:role/FlowinTerraformAdmin"
# assume_role_external_id = ""

# ---- Network ---------------------------------------------------------------

vpc_cidr           = "10.20.0.0/16"
public_subnet_cidr = "10.20.1.0/24"

# CIDRs allowed to reach 22/tcp on the instance. Empty list = no SSH ingress
# at all (use SSM Session Manager instead — recommended). Putting 0.0.0.0/0
# here is rejected by a validation block.
ssh_allowed_cidrs = [
  # "203.0.113.10/32",   # corporate egress
]

# ---- Compute ---------------------------------------------------------------

instance_type       = "m6i.2xlarge"
root_volume_size_gb = 100
data_volume_size_gb = 50

# Existing EC2 keypair name for emergency SSH. Empty = no keypair attached.
ssh_key_name = ""

# ---- DNS -------------------------------------------------------------------

# The hosted zone MUST already exist in this account; this Terraform looks it
# up but never creates it.
route53_zone_name = "example.com"
app_subdomain     = "flowin"
dns_ttl_seconds   = 60

# ---- Bedrock / LLM ---------------------------------------------------------

bedrock_model_id              = "anthropic.claude-haiku-4-5-20251001-v1:0"
bedrock_inference_profile_id  = "eu.anthropic.claude-haiku-4-5-20251001-v1:0"
use_inference_profile_for_app = true

# ---- Secrets — DO NOT commit real values -----------------------------------

# Audit B P2-6/P2-7: placeholders are DELIBERATELY shorter than the
# validation minimums (32 / 16 chars) so a `terraform apply` against this
# file as-is fails fast with a clear "must be at least N characters"
# error rather than silently deploying with a guessable secret. Set via
# env var TF_VAR_app_secret_key / TF_VAR_db_password with `openssl rand
# -hex 64` and `openssl rand -hex 32` respectively, or copy this file to
# terraform.tfvars (gitignored) and edit with real values.
#
#   export TF_VAR_app_secret_key="$(openssl rand -hex 64)"
#   export TF_VAR_db_password="$(openssl rand -hex 32)"
app_secret_key = "REPLACE_ME"
db_password    = "REPLACE_ME"

# Optional fallback. Empty = no parameter created.
anthropic_api_key = ""

# Optional LangSmith tracing — leave commented (empty values disable
# parameter creation; the LangChain client treats missing env as "off").
# Opt in by uncommenting all three; the on-host loader maps these
# UPPERCASE top-level keys directly to env vars of the same name.
# langsmith_tracing = "true"
# langsmith_api_key = "lsv2_pt_..."
# langsmith_project = "flowin-prod"

cors_origins              = "[\"https://flowin.example.com\"]"
access_token_expire_hours = 12

# ---- Backups ---------------------------------------------------------------

backup_bucket_name          = "flowin-prod-pg-dumps-123456789012"
# 365d matches docs/SIMPLE_AWS_DEPLOYMENT.md §11. AWS Backup requires
# (delete_after - cold_storage_after) >= 90; the default cold_storage_after
# of 30 satisfies this (365 - 30 = 335 >= 90).
daily_backup_retention_days = 365
cold_storage_after_days     = 30
# Current pg_dump archives in S3 expire after this many days. 365 matches
# the AWS Backup retention so the two storage tiers age out in lockstep.
pg_dump_expiry_days = 365

# ---- Backup Vault Lock (opt-in, ONE-WAY) -----------------------------------
# Vault Lock locks AWS Backup retention in compliance mode. Once the lock
# becomes immutable (3 days after apply), recovery points cannot be deleted
# before delete_after — even by root, even by AWS Support. Leave false until
# you've run real recovery drills against the chosen retention values.
enable_vault_lock             = false
vault_lock_min_retention_days = 7
vault_lock_max_retention_days = 365

# ---- S3 Object Lock (opt-in, CREATION-TIME-ONLY) ---------------------------
# Object Lock prevents overwrite/delete of pg_dump objects for a retention
# period. Mode is GOVERNANCE (an IAM principal with
# s3:BypassGovernanceRetention can override). MUST be set BEFORE the bucket
# exists — flipping this on an already-created bucket has no effect because
# the bucket has prevent_destroy = true and Object Lock can't be retrofitted.
# Default false; enable only for new deployments.
enable_object_lock         = false
object_lock_retention_days = 35

# ---- Monitoring ------------------------------------------------------------

alert_email                 = "flowin-oncall@hexaware.com"
log_retention_days          = 30
billing_alarm_threshold_usd = 500
# Daily Bedrock InputTokenCount cap (Sum over 24h). 5M input tokens at
# Haiku 4.5 list (~$4 / 1M input + ~$20 / 1M output) is a ~$20-input-plus-
# variable-output budget; tune up after a week of baseline data. See
# modules/monitoring/variables.tf for the rationale.
bedrock_daily_token_threshold = 5000000

# Audit D P2-5: per-log-group retention overrides. Empty means every group
# gets the global log_retention_days above (30d). Recommended split:
#   - nginx-access: 7d  — high-volume request log, low forensic value
#   - auth:         90d — sshd / sudo events, useful for incident response
#   - postgres:     30d (default)
#   - app:          30d (default)
log_retention_overrides = {
  "/flowin/prod/nginx-access" = 7
  "/flowin/prod/auth"         = 90
}

# ---- Phase 3 Audit D tunables (alarms) -------------------------------------
#
# These have sensible defaults; override only after a week of baseline.
#
# Bedrock throttle alarm threshold (Audit D P3-12). Default 5 = absorb
# short bursts but page on sustained quota pressure. Was 0 (hair-trigger).
# bedrock_throttles_threshold          = 5
# bedrock_throttles_evaluation_periods = 2
#
# Agent-error rate alarm threshold (Audit D P2-2). 20 errors per 5-min
# window for 2 consecutive windows = "sustained, not a burst".
# agent_error_rate_threshold = 20
#
# Stuck WorkflowRun alarm (Audit D P2-3). Period covers ~2 publishes from
# the on-host probe (which runs every 15 min).
# stuck_workflows_threshold    = 0
# stuck_workflows_check_period = 1800
