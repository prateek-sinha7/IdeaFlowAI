# Flowin Terraform-state bootstrap — example variable values.
#
# Copy this to `terraform.tfvars` (gitignored) and edit. This stack runs
# ONCE per account to create:
#   - the S3 bucket that holds Terraform state for envs/*
#   - the DynamoDB table for state locking
#   - a small bootstrap-local KMS CMK that encrypts both of the above
#
# After `terraform apply` here, copy the bucket name into
# infra/envs/prod/backend.tf (or pass via -backend-config) and run
# `terraform init` for the prod stack.

# 12-digit AWS account this stack runs against. Mismatch aborts plan.
expected_account_id = "123456789012"

# Region. Default is eu-central-1 — change only if your prod env runs elsewhere.
# aws_region = "eu-central-1"

# Tag values applied to every resource via provider default_tags.
owner       = "flowin-platform-team@hexaware.com"
cost_center = "UKI-FLOWIN-PROD"

# Globally-unique S3 bucket name. Convention: flowin-tfstate-<account>-<region>.
# Must be 3-63 chars. The bucket has prevent_destroy = true once created.
state_bucket_name = "flowin-tfstate-123456789012-eu-central-1"

# DynamoDB lock table. Default is fine for most deployments.
# lock_table_name = "flowin-tfstate-locks"
