# Terraform state — never commit. The remote backend lives in S3.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan files
*.tfplan
*.tfplan.*
plan.out

# Provider/cache directory
.terraform/
.terraform.tfstate.lock.info

# Module-level lock files are transient (created when an operator runs
# `terraform init` inside a module dir for validate/plan-isolation). The
# canonical lock files live in envs/* and ARE committed.
modules/*/.terraform.lock.hcl

# Variable files (.tfvars). Real values are operator-supplied and may
# contain secrets. Only the .example template is committed.
*.tfvars
*.auto.tfvars
*.auto.tfvars.json
!*.tfvars.example

# Exception: the LocalStack environment is a hermetic test fixture — its
# values are canonical (account 000000000000, stub AMI, dummy creds) and
# carry no secrets, so they ship with the repo.
!envs/localstack/terraform.tfvars

# Crash logs
crash.log
crash.*.log

# Override files (used to test local changes)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files (may have credentials)
.terraformrc
terraform.rc

# Editor scratch
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
