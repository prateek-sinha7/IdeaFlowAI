# =============================================================================
# Terraform — never commit state, plans, caches, or secret-bearing var files.
# Layout: infra/terraform/{bootstrap,shared,foundation,app,modules,policies}.
# =============================================================================

# Terraform state — the remote backend lives in S3. Local state (bootstrap
# only) and any stray state files must never be committed.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan files (may embed secret values from the diff)
*.tfplan
*.tfplan.*
plan.out
tfplan

# Provider/cache directory + lock-info
**/.terraform/
.terraform.tfstate.lock.info

# Module-level lock files are transient (created when an operator runs
# `terraform init` inside a module dir for validate-isolation). The canonical,
# committed lock files live in the layer roots (bootstrap/shared/foundation/app)
# for reproducible provider versions.
terraform/modules/*/.terraform.lock.hcl

# -----------------------------------------------------------------------------
# Variable files (.tfvars)
# -----------------------------------------------------------------------------
# Default: ignore ALL tfvars. Operator-supplied files (terraform.tfvars,
# bootstrap.tfvars, *.auto.tfvars) may carry secrets and must never be
# committed. Secrets are injected via TF_VAR_* / SSM, never via committed files.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Exception 1: example templates (placeholders only).
!*.tfvars.example

# Exception 2: the committed, NON-SECRET per-environment config the CI/CD
# pipeline consumes via `-var-file=<env>.tfvars` (infra/buildspec.yml). These
# hold only env shape (CIDRs, sizes, retention, DNS strategy) — zero secrets.
# Secrets for these environments come from TF_VAR_* (CI) and SSM at runtime.
# gitleaks + checkov scan them on every PR (see buildspec pre_build).
!terraform/foundation/dev.tfvars
!terraform/foundation/stage.tfvars
!terraform/foundation/prod.tfvars
!terraform/app/dev.tfvars
!terraform/app/stage.tfvars
!terraform/app/prod.tfvars

# Standalone internal-ALB layer (fronts the existing, non-Terraform-managed
# dev/stage/prod EC2 instances — one apply per environment via -var-file).
# Same non-secret shape as the exceptions above.
!terraform/velocityai-alb/dev.tfvars
!terraform/velocityai-alb/stage.tfvars
!terraform/velocityai-alb/prod.tfvars

# Exception 3: the LocalStack fixture is hermetic — its values are canonical
# (account 000000000000, stub AMI, dummy creds) and carry no secrets.
!terraform/**/localstack.tfvars

# -----------------------------------------------------------------------------
# Key material / secrets — never commit.
# -----------------------------------------------------------------------------
*.pem
*.key
*.pfx
*.p12
.env
.env.*
!.env.example

# Crash logs
crash.log
crash.*.log

# Override files (used to test local changes)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files (may have credentials)
.terraformrc
terraform.rc

# Editor scratch
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
