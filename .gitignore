# Environment files (contain secrets)
.env
.env.local
.env.*.local
# Local-dev compose env (devs copy from app.env.example).
# The .example template IS committed; the real file is not.
/app.env

# Local-dev compose overrides — see app.env.example for the convention.
docker-compose.override.yml

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.hypothesis/
.pytest_cache/
*.db
*.db.*
*.bak
*uv.lock
# Virtual environments
venv/
.venv/
env/

# pip --user installs landing inside a bind-mounted container WORKDIR
.local/

# Node.js
node_modules/
.next/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Spec Kit — local AI tooling, not tracked in version control
.specify/
.claude/
CLAUDE.md

# OS
.DS_Store
Thumbs.db

# Generated ESLint output files
frontend/eslint_code.txt
frontend/eslint_out.txt

# Generated OpenDesign gallery thumbnails — produced at build time
# (backend/scripts/generate_template_thumbnails.py, run from the backend
# Dockerfile), never committed. Missing thumbnails fall back to live iframes.
skills/opendesign/design-templates/*/thumbnail.jpg

# Backend run artifacts (UUID-based runtime data)
backend/runs/

# Eval harness run output + generated dashboard (regenerated from .runs/ JSON —
# see backend/evals/minimal/report.py)
backend/evals/minimal/.runs/
backend/evals/minimal/report.html

# Kiro IDE files (personal, not for team use)
.kiro/

# Apex agent-framework local workspace state (personal, not for team use)
.apex/

# understand-anything code-indexing tool local cache (personal, not for team use)
.understand-anything/

