# Environment files (contain secrets)
.env
.env.local
.env.*.local
# Local-dev compose env (devs copy from app.env.example).
# The .example template IS committed; the real file is not.
/app.env

# Local-dev compose overrides — see app.env.example for the convention.
docker-compose.override.yml

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.hypothesis/
.pytest_cache/
*.db
*.db.*
*.bak
*uv.lock
# Virtual environments
venv/
.venv/
env/

# pip --user installs landing inside a bind-mounted container WORKDIR
.local/

# Node.js
node_modules/
.next/
out/

# IDE
.idea/
*.swp
*.swo
.vscode/PythonImportHelper-v2-Completion.json

# Spec Kit — local AI tooling, not tracked in version control
.specify/
CLAUDE.md

# OS
.DS_Store
Thumbs.db

# Generated ESLint output files
frontend/eslint_code.txt
frontend/eslint_out.txt

# Generated OpenDesign gallery thumbnails — produced at build time
# (backend/scripts/generate_template_thumbnails.py, run from the backend
# Dockerfile), never committed. Missing thumbnails fall back to live iframes.
skills/opendesign/design-templates/*/thumbnail.jpg


# Kiro IDE files (personal, not for team use)
.kiro/
.kiro/*
!.kiro/steering/
!.kiro/skills/
.run
frontend/package-lock.json
frontend/package-lock.json

# Generated output from tools/api/runs/*.run.http integration tests — decks,
# prototypes, and WS/HTTP transcripts. Local-only, never committed.
/tools/api/runs/artifacts/
/tools/api/runs/logs/
tools/api/runs/.logs
tools/api/runs/.artifacts

# Eval run output — full real-model transcripts, prompts and replies. Large,
# regenerated on every run, and local-only: never committed.
#
# One rule, matched at any depth, so every eval package uses the same
# convention: backend/evals/hybrid/.runs/, backend/evals/grading/.runs/, and
# anything added later. (grading/ also carries its own nested .gitignore so the
# rule survives that folder being moved or vendored on its own.)
.runs/

# backend/evals/minimal/'s report.html lives at the package root (not under
# .runs/) so it survives .runs/ being wiped between runs — but it's still
# generated output (report.py regenerates it from stored JSON), not source.
backend/evals/minimal/report.html

# The frozen model_graded package records its runs under logs/ instead — it
# predates the .runs/ convention and is not being changed, but its transcripts
# are just as local-only.
/backend/evals/model_graded/logs/
