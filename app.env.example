# Flowin local-dev env file.
#
# Copy this to ./app.env at the repo root, fill in the blanks, then run:
#   docker compose up
#
# Compose reads BOTH /etc/flowin/app.env (production-only, doesn't exist on
# laptops) AND ./app.env (this one). Anything you set here is what the
# backend container actually sees.
#
# In production, /etc/flowin/app.env is generated on every start by
# /usr/local/bin/flowin-load-secrets — see docs/SIMPLE_AWS_DEPLOYMENT.md §9.3.
# Local devs should NOT try to mimic that flow; just edit this file.

# ---- Required runtime ------------------------------------------------------

# Anything other than `development` requires SECRET_KEY to be a real 32+ char
# value (the boot guard in app/core/config.py rejects weak/default keys outside
# dev). Stick with `development` for local work.
ENV=development

# >= 32 chars. Anything goes in dev. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-32-or-more-chars-of-random-padding-for-dev-mode

# Postgres reachable from the backend container. With the compose stack as
# shipped, the Postgres host is your laptop (started via
# `docker run --name flowin-pg-test -p 5432:5432 -e POSTGRES_DB=flowin
# -e POSTGRES_USER=flowin -e POSTGRES_PASSWORD=... postgres:16`), reached
# from inside the container as `host.docker.internal`.
DATABASE_URL=postgresql://flowin:flowin_test_pw@host.docker.internal:5432/flowin

# Comma-separated JSON array. Should include the frontend origin you'll hit.
CORS_ORIGINS=["http://localhost:3000"]

# Lifetime in hours of a LOCALLY-MINTED HS256 token. Post-Cognito this governs
# only the break-glass admin's session (see AUTH_PROVIDER below) -- Cognito
# controls its own token lifetimes on the app client, so this is NOT the global
# session length.
ACCESS_TOKEN_EXPIRE_HOURS=12

# ---- Authentication provider (COGNITO-MIGRATION-PLAN) ---------------------

# `local`   -> email/password verified against the local bcrypt hash, HS256
#              tokens minted here. This is the default and needs no AWS setup.
# `cognito` -> Cognito is the credential + role authority. Requires the three
#              COGNITO_* values below; outside ENV=development the app REFUSES
#              to boot without them (in development it only warns), so a
#              half-configured host fails loudly instead of silently.
AUTH_PROVIDER=local

# Dual-accept window. While true, BOTH legacy HS256 and Cognito RS256 tokens
# are accepted, so flipping AUTH_PROVIDER forces zero logouts. Set to false
# only after outstanding legacy tokens have aged out.
AUTH_ALLOW_LEGACY_JWT=true

# Keeps exactly ONE local-password admin usable even when Cognito is
# unreachable. The single-row invariant is enforced in code: if a second local
# admin ever exists, this credential path stops being honoured entirely.
BREAK_GLASS_ENABLED=true

# ---- Cognito (only needed when AUTH_PROVIDER=cognito) ---------------------

# In production these arrive from SSM via the on-host secrets loader. Locally,
# point them at a dev pool you own. NEVER commit real values -- the client
# secret is a credential (it computes SECRET_HASH on every Admin* auth call).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# Defaults to AWS_REGION when left empty; kept separate because the Cognito
# pool and the Bedrock region are configured independently.
COGNITO_REGION=

# How long the pool's public signing keys (JWKS) are cached in-process. Token
# verification is offline against this cache, so in-flight sessions survive a
# Cognito control-plane blip. An unknown key id triggers a single refetch, so
# key rotation self-heals without a restart.
COGNITO_JWKS_CACHE_TTL_SECONDS=3600

# Require a confirmed TOTP device for /api/admin/* (Cognito principals only;
# the break-glass admin is exempt by design). Leave false until every admin has
# enrolled -- enabling it first locks them out of admin routes.
ADMIN_MFA_REQUIRED=false

# ---- Bedrock (AWS) --------------------------------------------------------

# The app calls Bedrock unconditionally. Without AWS creds in your shell or
# ~/.aws/credentials, every agent run dies on `NoCredentialsError` (mapped
# to a non-recoverable auth_error). Configure SSO / a profile when you want
# real LLM calls.
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_INFERENCE_PROFILE_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# ---- Image refs (pinned to local-build tags by default) -------------------

# Compose interpolates these. `flowin-backend:local` and `flowin-frontend:local`
# are the tags `docker compose build` produces; in CI/prod these get overridden
# with full ECR URIs (e.g. <ACCOUNT>.dkr.ecr.<region>.amazonaws.com/flowin-prod-
# backend:v20260510-abc1234) by the deploy script.
BACKEND_IMAGE=flowin-backend:local
FRONTEND_IMAGE=flowin-frontend:local

# Frontend NEXT_PUBLIC_* values are baked into the JS bundle at BUILD time —
# changing them here at runtime has no effect. To change them, rebuild the
# frontend image with `--build-arg NEXT_PUBLIC_API_URL=...` (compose does
# this automatically when the args are set in the env file at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
