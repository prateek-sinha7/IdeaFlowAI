# Flowin Docker Compose Configuration
#
# Copy to app.env (do not commit) for containerized local development.
# Native development should use backend/.env.example and frontend/.env.example instead.
# Production credentials arrive via the secrets loader; keep local values in app.env only.

# ---- Backend Configuration ----
ENV=development
SECRET_KEY=CHANGE_ME_generate_with_python_-c_"import_secrets;_print(secrets.token_urlsafe(48))"

# PostgreSQL via Docker network (host.docker.internal for host access).
DATABASE_URL=postgresql+psycopg://<postgres-user>:<postgres-password>@host.docker.internal:5432/velocityai

CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_BASE_URL=http://localhost:3000
RUNS_ROOT=/app/runs

# ---- AI Workflow Builder (all optional; values shown are the defaults) ----
# Empty = <RUNS_ROOT>/_builder. Sweeps of RUNS_ROOT must skip _builder/.
# BUILDER_SANDBOX_ROOT=
# The builder skill is always backend/app/agents/workflow_builder/skills/velocity-workflow-creator.
# BUILDER_TURN_TIMEOUT_SECONDS=900
# BUILDER_LIMIT_WARNING_FRACTION=0.8
# BUILDER_MAX_TOOL_CALLS_PER_TURN=60
# BUILDER_MAX_GATE_REJECTIONS_PER_TURN=2
# BUILDER_MAX_MESSAGE_CHARS=12000
# BUILDER_MAX_TURNS_PER_SESSION=100
# BUILDER_MESSAGES_PER_MINUTE=5
# BUILDER_MAX_RUNNING_TURNS_PER_USER=2
# BUILDER_MAX_CANVAS_STATE_BYTES=524288
# Token budgets are unenforced until set (leave unset = no limit).
# BUILDER_TOKEN_BUDGET_PER_TURN=
# BUILDER_TOKEN_BUDGET_PER_SESSION=
# BUILDER_TOKEN_BUDGET_PER_USER_DAY=
# BUILDER_REPLAY_BUDGET_FRACTION=0.25
# BUILDER_REPLAY_VERBATIM_TURNS=4
# BUILDER_CLARIFY_TURNS_BEFORE_DRAFT=2
# Intake "ask before assume": one no-tool call asks functional questions before the builder.
# On by default; set false to roll back to the old path at once (the builder asks itself).
# BUILDER_INTAKE_V2_ENABLED=true
# Question rounds the intake may send before it builds anyway (at least 1).
# Reaching the limit counts as the user replying "defaults".
# BUILDER_INTAKE_MAX_ROUNDS=2
# Intake reasoning effort: default (the turn's own effort) or highest (the model's top level).
# "highest" cost about 7x and ran about 10x slower in evals with no quality gain.
# BUILDER_INTAKE_EFFORT=default
# BUILDER_SCRIPT_TIMEOUT_SECONDS=30
# BUILDER_SCRIPT_OUTPUT_CAP_CHARS=80000
# BUILDER_MAX_CONCURRENT_SCRIPTS=8
# BUILDER_SHUTDOWN_PERSIST_SECONDS=2.0

# ---- Connectors (Jira and GitHub OAuth apps) ----
# Browser-visible origin of the app: scheme, host and port; no path, no trailing slash.
# Empty falls back to PUBLIC_BASE_URL. Register APP_BASE_URL + OAUTH_REDIRECT_PATH as the
# callback URL in both provider consoles, exactly.
APP_BASE_URL=http://localhost:3000
# OAUTH_REDIRECT_PATH=/api/connectors/oauth/callback
# Fernet key(s) that encrypt stored provider tokens. Comma-separated: the first encrypts,
# all decrypt (rotation). Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional tuning (defaults shown)
# CONNECTOR_TOOL_SCHEMA_TTL_SECONDS=600
# CONNECTOR_REFRESH_SKEW_SECONDS=300
# CONNECTOR_HTTP_TIMEOUT_SECONDS=10

# ---- Cognito Authentication ----
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REGION=eu-central-1
COGNITO_JWKS_CACHE_TTL_SECONDS=3600
ADMIN_MFA_REQUIRED=false
AUTH_EMAIL_MFA_ENABLED=false

# ---- LLM Provider (Bedrock) ----
# Container inherits AWS credentials from host or ~/.aws/. Do not put keys here.
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
BEDROCK_INFERENCE_PROFILE_ID=eu.anthropic.claude-haiku-5-5
# ANTHROPIC_API_KEY=

# ---- Docker Compose Images ----
BACKEND_IMAGE=velocityai-backend:local
FRONTEND_IMAGE=velocityai-frontend:local

# ---- Frontend ----
# Inlined at build time. Empty = same-origin /api proxy (for production nginx).
NEXT_PUBLIC_API_URL=http://localhost:8000
