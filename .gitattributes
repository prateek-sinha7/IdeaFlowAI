# Normalize line endings so files that execute on Linux hosts never carry
# Windows CRLF, regardless of the OS a contributor checks out on.
#
# Why this matters here: infra/scripts/bootstrap-ec2.sh and the rendered
# user-data template are shipped to (and executed on) Ubuntu EC2 hosts. A
# CRLF checkout makes bash fail with `$'\r': command not found`. Forcing LF
# on shell + shell-template files keeps the on-host execution correct even
# when the repo is cloned on Windows.

# Shell scripts and shell templates -> always LF
*.sh      text eol=lf
*.bash    text eol=lf
*.sh.tpl  text eol=lf

# Terraform sources -> LF (harmless, keeps diffs clean across OSes)
*.tf      text eol=lf
*.tfvars  text eol=lf

# Characterization / prompt-baseline golden files -> NEVER text-normalized.
# These are byte-for-byte oracles (INV-3 / D-07): tests read them with
# `Path.read_bytes()` and assert exact equality against composed output. Without
# `-text` here, a Windows checkout can silently rewrite committed LF bytes to
# CRLF, corrupting the golden and false-failing every byte-identity assertion
# against it (task.md Phase 0 CRLF/golden-EOL group).
backend/tests/agents/characterization/golden/**  -text
backend/tests/**/golden/**                       -text
backend/tests/**/*.golden                        -text
