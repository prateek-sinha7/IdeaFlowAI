# TEMPLATE — copy to grading/configs/<name>.yaml and fill in.
#
# A RUN CONFIG: every input that affects a grading run's outcome, in one file, so
# a run is reproducible from `--config <path>` instead of from remembering a flag
# combination. `.template` suffix so globs and YAML loaders skip it.
#
# WHAT REPRODUCIBLE MEANS HERE: this file fixes the INPUTS — dataset, rows,
# models, judge, thresholds. It cannot fix the OUTPUTS, because an LLM run is not
# deterministic. Running one config N times is how you MEASURE that variance, not
# a way to eliminate it. That is what `options.repeats` is for.

# Human label for this config. Appears in run_summary.json. NOT a dataset_run_id
# — those are minted per run as {YYMMDD-HHMMSS}-{dataset_id}.
run_id: my-run-name

track: model                  # model | code
workflow: prototype           # folder under model/workflows/


# ── WHAT TO RUN ───────────────────────────────────────────────────────────
# Path to the dataset file. Relative paths resolve against the workflow folder
# (model/workflows/<workflow>/), so `datasets/x.json` is the normal form; an
# absolute path is used as-is, for a scratch dataset outside the repo.
#
# The file carries its own `dataset_id`, which is what names the run folder.
# A dataset is NOT bound to an agent by its filename — a file generated by one
# stage is a valid input dataset for the next, so binding happens here.
dataset: datasets/your-dataset.json

# WHICH AGENTS TO RUN. Either:
#   all              every stage with status: implemented, in workflow.yaml
#                    order, into one run folder — stopping at the first stage
#                    that is not implemented.
#   [a, b, c]        an explicit subset. Always executed in WORKFLOW order, not
#                    the order you list them in.
#
# A listed agent's upstream must be satisfiable: either an earlier agent in this
# same run, or already present in the `from_run` folder. Otherwise the run fails
# naming the missing artifacts — it never silently falls back to the dataset.
agents: all

# Resolve upstream inputs from an existing run folder, and write into it.
# Required whenever the first agent to run is not the workflow's root stage.
from_run: null

# Row subset. Omit both for every row. `rows` wins over `limit` if both given.
rows: null                    # e.g. [billing_console, hr_ats]
limit: null                   # e.g. 3 — first N rows


# ── MODELS ────────────────────────────────────────────────────────────────
# The agent being graded. null/null uses build_model's implicit fallback chain
# (ANTHROPIC_API_KEY -> Bedrock -> mistral).
#
# WARNING: build_model only honours provider "mistral". Any other
# value — including "anthropic" and "bedrock" — is SILENTLY IGNORED and falls
# through the chain. Whatever you set, the artifacts record the model that
# actually resolved, and a mismatch against what you pinned is a warning.
agent_under_test:
  provider: null
  model: null

# Overrides the rubric's own pinned `judge:` block. Setting this is recorded as
# an override, because it changes what a score means — leave it null to use the
# rubric's pin, which is what keeps runs comparable by default.
judge:
  provider: null
  model: null
  threshold: null


# ── HOW TO RUN ────────────────────────────────────────────────────────────
options:
  # Rows in flight within a stage. Stages are always sequential (each needs the
  # previous stage's output). Keep this modest — both the agent and the judge
  # will rate-limit.
  concurrency: 3

  # Precheck only. Costs zero judge tokens; still dispatches the agent.
  no_judge: false

  # N independent runs of this exact config, each its own run folder, plus a
  # variance report across them. Use this to find out whether a score is a
  # measurement or a single sample — a judge returning the same number every
  # time is the failure mode this folder exists to catch.
  repeats: 1
