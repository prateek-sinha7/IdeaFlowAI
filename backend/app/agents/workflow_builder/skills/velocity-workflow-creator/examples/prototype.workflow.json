{
  "id": "prototype",
  "version": 1,
  "user_launchable": true,
  "is_beta": false,
  "display_name": "Build an interactive prototype (Fast)",
  "short_name": "Prototype",
  "icon": "Layout",
  "chained_from": [
    {
      "id": "user_stories",
      "beta": false,
      "text": "Mockup these stories"
    },
    {
      "id": "ppt",
      "beta": false,
      "text": "Build the interactive demo"
    },
    {
      "id": "ppt_v2",
      "beta": false,
      "text": "Build the interactive demo"
    }
  ],
  "description": "Navigable, high-fidelity HTML prototype from a brief or story set.",
  "launch_surface": "wizard",
  "planner": "run",
  "clarify": {
    "rounds": 2,
    "mode": "auto",
    "defaults": [
      "target_audience",
      "scope",
      "priority",
      "style",
      "user_journeys",
      "key_screens",
      "interactions",
      "personas"
    ]
  },
  "deliverable": {
    "strategy": "single_file",
    "name": "prototype.html",
    "chains_from": true
  },
  "context_providers": [
    "opendesign",
    "chain_context"
  ],
  "input_providers": [
    "run_images"
  ],
  "seed_files": {},
  "steps": [
    {
      "strategy": "single_shot",
      "depends_on": [],
      "model": {
        "model": "eu.anthropic.claude-sonnet-5-5"
      },
      "agent": "design-ingestor",
      "instance_id": "design-ingestor",
      "name": "Design Ingestor",
      "condition": "source_type in ['html', 'figma']",
      "skills": [
        "design-ingestor"
      ],
      "tools": {
        "read_files": true,
        "write_files": true,
        "exec": false,
        "tool_sets": [
          "file_extract"
        ]
      },
      "gates": []
    },
    {
      "agent": "prototype-specify",
      "strategy": "single_shot",
      "tools": {
        "read_files": true,
        "write_files": false,
        "exec": false
      },
      "skills": [
        "velocity-design"
      ],
      "gates": []
    },
    {
      "agent": "prototype-plan",
      "strategy": "single_shot",
      "gates": []
    },
    {
      "agent": "prototype-analyze",
      "strategy": "single_shot",
      "gates": []
    },
    {
      "agent": "prototype-build",
      "tools": {
        "read_files": true,
        "write_files": true
      },
      "strategy": "task_loop",
      "gates": [],
      "task_source": {
        "kind": "parsed",
        "parser": "heading_tasks",
        "target": "tasks.md",
        "source_step": "prototype-plan",
        "spec_step": "prototype-specify"
      },
      "validators": [
        "html_static",
        "html_render"
      ],
      "require_render": true,
      "compaction": "html_skeleton"
    },
    {
      "agent": "prototype-validate",
      "tools": {
        "read_files": true,
        "write_files": true
      },
      "strategy": "single_shot",
      "gates": []
    }
  ],
  "name": "Prototype"
}
