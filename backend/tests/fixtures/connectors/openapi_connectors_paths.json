{
  "components": {
    "schemas": {
      "AuthorizeResponse": {
        "description": "Where to send the user to approve the connection.",
        "properties": {
          "authorization_url": {
            "title": "Authorization Url",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "authorization_url",
          "expires_at"
        ],
        "title": "AuthorizeResponse",
        "type": "object"
      },
      "ConnectorAccount": {
        "description": "The provider account behind a connection.",
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "login": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Login"
          }
        },
        "required": [
          "id",
          "display_name",
          "login"
        ],
        "title": "ConnectorAccount",
        "type": "object"
      },
      "ConnectorListResponse": {
        "description": "All connectors, in catalog order.",
        "properties": {
          "connectors": {
            "items": {
              "$ref": "#/components/schemas/ConnectorSummary"
            },
            "title": "Connectors",
            "type": "array"
          }
        },
        "required": [
          "connectors"
        ],
        "title": "ConnectorListResponse",
        "type": "object"
      },
      "ConnectorSite": {
        "description": "A Jira site the connection can reach.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "url"
        ],
        "title": "ConnectorSite",
        "type": "object"
      },
      "ConnectorSummary": {
        "description": "One connector card.",
        "properties": {
          "account": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConnectorAccount"
              },
              {
                "type": "null"
              }
            ]
          },
          "connected_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Connected At"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "docs_url": {
            "title": "Docs Url",
            "type": "string"
          },
          "granted_scopes": {
            "items": {
              "type": "string"
            },
            "title": "Granted Scopes",
            "type": "array"
          },
          "icon": {
            "title": "Icon",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "last_refreshed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Refreshed At"
          },
          "mode": {
            "enum": [
              "remote_mcp",
              "native_api"
            ],
            "title": "Mode",
            "type": "string"
          },
          "requested_scopes": {
            "items": {
              "type": "string"
            },
            "title": "Requested Scopes",
            "type": "array"
          },
          "sites": {
            "items": {
              "$ref": "#/components/schemas/ConnectorSite"
            },
            "title": "Sites",
            "type": "array"
          },
          "status": {
            "enum": [
              "connected",
              "not_connected",
              "expired",
              "not_configured"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "key",
          "display_name",
          "description",
          "icon",
          "docs_url",
          "mode",
          "status",
          "account",
          "requested_scopes",
          "granted_scopes",
          "sites",
          "connected_at",
          "last_refreshed_at"
        ],
        "title": "ConnectorSummary",
        "type": "object"
      },
      "ConnectorTool": {
        "description": "One tool a workflow step can switch on.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source_name": {
            "title": "Source Name",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "write_capable": {
            "title": "Write Capable",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "source_name",
          "title",
          "description",
          "write_capable"
        ],
        "title": "ConnectorTool",
        "type": "object"
      },
      "ConnectorToolsResponse": {
        "description": "The tools of one connector.",
        "properties": {
          "connector": {
            "title": "Connector",
            "type": "string"
          },
          "listed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Listed At"
          },
          "status": {
            "enum": [
              "connected",
              "not_connected",
              "expired"
            ],
            "title": "Status",
            "type": "string"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ConnectorTool"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "connector",
          "status",
          "tools",
          "listed_at"
        ],
        "title": "ConnectorToolsResponse",
        "type": "object"
      },
      "DisconnectResponse": {
        "description": "Result of a disconnect.",
        "properties": {
          "provider_revocation": {
            "enum": [
              "revoked",
              "failed",
              "not_attempted"
            ],
            "title": "Provider Revocation",
            "type": "string"
          },
          "status": {
            "const": "disconnected",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "provider_revocation"
        ],
        "title": "DisconnectResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "paths": {
    "/api/connectors": {
      "get": {
        "description": "List every connector with the caller's connection status.",
        "operationId": "list_connectors_api_connectors_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "_BearerScheme": []
          }
        ],
        "summary": "List Connectors",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/connectors/oauth/callback": {
      "get": {
        "description": "Finish an authorization from the provider's redirect (public route).\n\nAlways answers 303 to the landing page, never JSON, so no length limit is\ndeclared here (a limit would answer 422); the service validates every value and\nmaps a bad one to a reason code. ``error_description`` is ignored: it is never\nstored, logged or echoed.",
        "operationId": "oauth_callback_api_connectors_oauth_callback_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "in": "query",
            "name": "iss",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Iss"
            }
          },
          {
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error"
            }
          },
          {
            "in": "query",
            "name": "error_description",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Error Description"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Oauth Callback",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/connectors/{key}": {
      "delete": {
        "description": "Revoke the grant at the provider (best effort) and delete the local connection.",
        "operationId": "disconnect_connector_api_connectors__key__delete",
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "title": "Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisconnectResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "_BearerScheme": []
          }
        ],
        "summary": "Disconnect Connector",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/connectors/{key}/authorize": {
      "post": {
        "description": "Start an authorization and return the provider URL for the popup.",
        "operationId": "authorize_connector_api_connectors__key__authorize_post",
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "title": "Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "_BearerScheme": []
          }
        ],
        "summary": "Authorize Connector",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/connectors/{key}/tools": {
      "get": {
        "description": "List the tools of a connector the caller can switch on in a workflow step.",
        "operationId": "list_connector_tools_api_connectors__key__tools_get",
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "title": "Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorToolsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "_BearerScheme": []
          }
        ],
        "summary": "List Connector Tools",
        "tags": [
          "connectors"
        ]
      }
    }
  }
}
