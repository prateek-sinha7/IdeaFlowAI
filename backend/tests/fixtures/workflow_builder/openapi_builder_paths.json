            "title": "Skill Hash"
          },
          "skill_updated": {
            "title": "Skill Updated",
            "type": "boolean"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "running",
                  "completed",
                  "failed",
                  "cancelled",
                  "timed_out",
                  "interrupted"
                ],
                "type": "string"
              },
              {
                "const": "accepted",
                "type": "string"
              }
            ],
            "title": "Status"
          },
          "stop_reason": {
            "anyOf": [
              {
                "enum": [
                  "time",
                  "tool_calls",
                  "tokens",
                  "recursion",
                  "gate_rejections",
                  "cancelled",
                  "deleted",
                  "shutdown",
                  "restart",
                  "error"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Reason"
          },
          "thinking": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thinking"
          },
          "turn_id": {
            "title": "Turn Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "seq",
          "role",
          "turn_id",
          "reply_to_message_id",
          "status",
          "outcome",
          "stop_reason",
          "content",
          "thinking",
          "model_id",
          "effort",
          "skill_hash",
          "skill_updated",
          "error",
          "revision",
          "activity",
          "activity_summary",
          "created_at",
          "ended_at"
        ],
        "title": "TranscriptMessage",
        "type": "object"
      },
      "TurnAccepted": {
        "additionalProperties": false,
        "description": "Answer to an admitted message or retry (202).",
        "properties": {
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "replayed": {
            "default": false,
            "title": "Replayed",
            "type": "boolean"
          },
          "turn_id": {
            "title": "Turn Id",
            "type": "string"
          }
        },
        "required": [
          "turn_id",
          "message_id"
        ],
        "title": "TurnAccepted",
        "type": "object"
      },
      "UndoRequest": {
        "additionalProperties": false,
        "description": "Body of ``POST /sessions/{id}/undo``.",
        "properties": {
          "expected_revision": {
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          }
        },
        "required": [
          "expected_revision"
        ],
        "title": "UndoRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
