      "ModelCatalogEntry": {
        "description": "One model-picker entry, projected from ``ModelCatalog`` (MODEL-04).\n\nRFN-002b: pricing rates added (USD per 1 M tokens, scaled from the catalog's\nper-single-token ``Pricing`` dataclass × 1 000 000) so the Analytics page can\nbuild a fully dynamic model-details panel without a hardcoded rate table.\n``reasoning_mode``/``reasoning_levels`` are projected off the catalog's\n``Reasoning`` capability (spec 020) — they replace a ``thinking_supported``\nbool derived from an id-substring tuple.\nAll new fields have safe defaults so existing callers that don't read them\nare unaffected (purely additive).",
        "properties": {
          "cache_read_rate_per_1m": {
            "default": 0.0,
            "title": "Cache Read Rate Per 1M",
            "type": "number"
          },
          "cache_write_5m_rate_per_1m": {
            "default": 0.0,
            "title": "Cache Write 5M Rate Per 1M",
            "type": "number"
          },
          "context_window": {
            "title": "Context Window",
            "type": "integer"
          },
          "cost_class": {
            "title": "Cost Class",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input_rate_per_1m": {
            "default": 0.0,
            "title": "Input Rate Per 1M",
            "type": "number"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "output_rate_per_1m": {
            "default": 0.0,
            "title": "Output Rate Per 1M",
            "type": "number"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "reasoning_levels": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Reasoning Levels",
            "type": "array"
          },
          "reasoning_mode": {
            "default": "none",
            "title": "Reasoning Mode",
            "type": "string"
          },
          "tier": {
            "title": "Tier",
            "type": "string"
          },
          "user_allowed": {
            "title": "User Allowed",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "tier",
          "cost_class",
          "provider",
          "context_window",
          "user_allowed"
        ],
        "title": "ModelCatalogEntry",
        "type": "object"
      },
      "RunningTurnSnapshot": {
        "additionalProperties": false,
        "description": "The running Turn as a connecting client needs to see it (Req 38.3).\n\n``through_seq`` is the ``seq`` of the last event this snapshot already\nreflects, so a client drops turn events with ``seq <= through_seq``\n[pending G-14].",
        "properties": {
          "activity": {
            "items": {
              "$ref": "#/components/schemas/ToolActivity"
            },
            "title": "Activity",
            "type": "array"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Checks",
            "type": "array"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "message_id": {
            "title": "Message Id",
            "type": "string"
          },
          "stage": {
            "$ref": "#/components/schemas/Stage"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "through_seq": {
            "minimum": 0.0,
            "title": "Through Seq",
            "type": "integer"
          },
          "turn_id": {
            "title": "Turn Id",
            "type": "string"
          }
        },
        "required": [
          "turn_id",
          "message_id",
          "stage",
          "label",
          "started_at",
          "through_seq",
          "activity",
          "checks"
        ],
        "title": "RunningTurnSnapshot",
        "type": "object"
      },
