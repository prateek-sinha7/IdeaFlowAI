          "enum": [
            "idle",
            "running"
          ],
          "title": "State",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "snapshot",
          "default": "snapshot",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "state",
        "running_turn",
        "latest_message_id",
        "latest_revision",
        "latest_unproposed_revision"
      ],
      "title": "Snapshot",
      "type": "object"
    },
