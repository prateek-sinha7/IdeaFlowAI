    "Snapshot": {
      "additionalProperties": false,
      "description": "Sent first on every connection (Req 38.3, pending G-14).",
      "properties": {
        "latest_message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Message Id"
        },
        "latest_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Revision"
        },
        "latest_unproposed_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Unproposed Revision"
        },
        "running_turn": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunningTurnSnapshot"
            },
            {
              "type": "null"
            }
          ]
