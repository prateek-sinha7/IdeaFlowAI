{
  "$defs": {
    "ChangeSummary": {
      "additionalProperties": false,
      "description": "What a Draft changed compared with the Canvas state it was based on.",
      "properties": {
        "added": {
          "items": {
            "type": "string"
          },
          "title": "Added",
          "type": "array"
        },
        "gates_changed": {
          "items": {
            "type": "string"
          },
          "title": "Gates Changed",
          "type": "array"
        },
        "models_changed": {
          "items": {
            "type": "string"
          },
          "title": "Models Changed",
          "type": "array"
        },
        "prompts_changed": {
          "title": "Prompts Changed",
          "type": "integer"
        },
        "removed": {
          "items": {
            "type": "string"
          },
          "title": "Removed",
          "type": "array"
        },
        "reordered": {
          "title": "Reordered",
          "type": "boolean"
        },
        "validators_changed": {
          "items": {
            "type": "string"
          },
          "title": "Validators Changed",
          "type": "array"
        }
      },
      "required": [
        "added",
        "removed",
        "reordered",
        "gates_changed",
        "validators_changed",
        "models_changed",
        "prompts_changed"
      ],
      "title": "ChangeSummary",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "description": "The verdict of one validator run, dry run or Server_Gate check.",
      "properties": {
        "attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "attempts_left": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempts Left"
        },
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "source": {
          "enum": [
            "skill_validator",
            "platform_dry_run",
            "server_gate"
          ],
          "title": "Source",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "warnings": {
          "title": "Warnings",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "verdict",
        "errors",
        "warnings"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "CheckResultEvent": {
      "additionalProperties": false,
      "description": "One validator, dry-run or gate check returned (Req 38.10).",
      "properties": {
        "attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt"
        },
        "attempts_left": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempts Left"
        },
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "source": {
          "enum": [
            "skill_validator",
            "platform_dry_run",
            "server_gate"
          ],
          "title": "Source",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        },
        "type": {
          "const": "check_result",
          "default": "check_result",
          "title": "Type",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "warnings": {
          "title": "Warnings",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "turn_id",
        "seq",
        "source",
        "verdict",
        "errors",
        "warnings",
        "attempt",
        "attempts_left"
      ],
      "title": "CheckResultEvent",
      "type": "object"
    },
    "DraftApplied": {
      "additionalProperties": false,
      "description": "The Server_Gate accepted a Draft (Req 38.11).",
      "properties": {
        "change_summary": {
          "$ref": "#/$defs/ChangeSummary"
        },
        "launch_needs": {
          "items": {
            "$ref": "#/$defs/LaunchNeed"
          },
          "title": "Launch Needs",
          "type": "array"
        },
        "manifest": {
          "additionalProperties": true,
          "title": "Manifest",
          "type": "object"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "target_trust": {
          "enum": [
            "user",
            "db"
          ],
          "title": "Target Trust",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        },
        "type": {
          "const": "draft_applied",
          "default": "draft_applied",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "turn_id",
        "seq",
        "revision",
        "target_trust",
        "change_summary",
        "launch_needs",
        "manifest"
      ],
      "title": "DraftApplied",
      "type": "object"
    },
    "DraftRestored": {
      "additionalProperties": false,
      "description": "An Undo stored a restored Canvas state as a new revision [pending G-16].",
      "properties": {
        "manifest": {
          "additionalProperties": true,
          "title": "Manifest",
          "type": "object"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "draft_restored",
          "default": "draft_restored",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "revision",
        "manifest"
      ],
      "title": "DraftRestored",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "description": "A failure the user should see (Req 38.15).\n\n``turn_id`` and ``seq`` are set when the error belongs to a Turn.\n``message`` is generic: never a stack trace, SQL text or path.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Seq"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turn Id"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "turn_id",
        "seq",
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "LaunchNeed": {
      "additionalProperties": false,
      "description": "Something the user must provide before the workflow can launch.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "kind": {
          "enum": [
            "uploads",
            "design",
            "connector",
            "source_run"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LaunchNeed",
      "type": "object"
    },
    "LimitWarning": {
      "additionalProperties": false,
      "description": "A Turn reached 80 % of a limit (Req 38.13).",
      "properties": {
        "kind": {
          "enum": [
            "time",
            "tool_calls",
            "tokens"
          ],
          "title": "Kind",
          "type": "string"
        },
        "limit": {
          "title": "Limit",
          "type": "integer"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        },
        "type": {
          "const": "limit_warning",
          "default": "limit_warning",
          "title": "Type",
          "type": "string"
        },
        "used": {
          "title": "Used",
          "type": "integer"
        }
      },
      "required": [
        "ts",
        "turn_id",
        "seq",
        "kind",
        "used",
        "limit"
      ],
      "title": "LimitWarning",
      "type": "object"
    },
    "RunningTurnSnapshot": {
      "additionalProperties": false,
      "description": "The running Turn as a connecting client needs to see it (Req 38.3).\n\n``through_seq`` is the ``seq`` of the last event this snapshot already\nreflects, so a client drops turn events with ``seq <= through_seq``\n[pending G-14].",
      "properties": {
        "activity": {
          "items": {
            "$ref": "#/$defs/ToolActivity"
          },
          "title": "Activity",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "through_seq": {
          "minimum": 0,
          "title": "Through Seq",
          "type": "integer"
        },
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "message_id",
        "stage",
        "label",
        "started_at",
        "through_seq",
        "activity",
        "checks"
      ],
      "title": "RunningTurnSnapshot",
      "type": "object"
    },
    "SessionDeleted": {
      "additionalProperties": false,
      "description": "The Session was deleted; the stream closes after this event.",
      "properties": {
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "session_deleted",
          "default": "session_deleted",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "ts"
      ],
      "title": "SessionDeleted",
      "type": "object"
    },
    "SessionRevoked": {
      "additionalProperties": false,
      "description": "The caller's token was revoked (existing run-stream name and shape).",
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
