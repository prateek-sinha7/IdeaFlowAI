# Flowin Backend — Local Development Environment
#
# Copy to backend/.env (do not commit). CHANGE_ME values must be supplied.
# PostgreSQL is required; Docker and SQLite are not supported.

# ---- Core Configuration ----
ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_with_python_-c_"import_secrets;_print(secrets.token_urlsafe(48))"

# PostgreSQL connection. Use your local PostgreSQL instance at localhost:5432.
DATABASE_URL=postgresql+psycopg://<postgres-user>:<postgres-password>@localhost:5432/velocityai

CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_BASE_URL=http://localhost:3000
RUNS_ROOT=./runs

# ---- Cognito Authentication ----
# Cognito is the sole authentication authority (no local fallback).
# Get these values from your environment owner or dev pool.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REGION=eu-central-1
COGNITO_JWKS_CACHE_TTL_SECONDS=3600

# Require MFA for admin operations. Do not enable until all admins have enrolled.
ADMIN_MFA_REQUIRED=false

# Matches the pool's email-OTP constraint (published by Terraform).
AUTH_EMAIL_MFA_ENABLED=false

# ---- LLM Provider (Bedrock) ----
# Bedrock uses AWS credential chain; set AWS_PROFILE in your shell:
#   $env:AWS_PROFILE = "your-profile"
#   aws sso login
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_INFERENCE_PROFILE_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional: Direct Anthropic API key (Bedrock takes precedence).
# ANTHROPIC_API_KEY=

# ---- Observability ----
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
