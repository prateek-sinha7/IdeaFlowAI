# Flowin Backend — Local Development Environment
#
# Copy to backend/.env (do not commit). CHANGE_ME values must be supplied.
# PostgreSQL is required; Docker and SQLite are not supported.

# ---- Core Configuration ----
ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_with_python_-c_"import_secrets;_print(secrets.token_urlsafe(48))"

# PostgreSQL connection. Use your local PostgreSQL instance at localhost:5432.
DATABASE_URL=postgresql+psycopg://<postgres-user>:<postgres-password>@localhost:5432/velocityai

CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_BASE_URL=http://localhost:3000
RUNS_ROOT=./runs

# ---- Connectors (Jira and GitHub OAuth apps) ----
# Browser-visible origin of the app: scheme, host and port; no path, no trailing slash.
# Empty falls back to PUBLIC_BASE_URL. Register APP_BASE_URL + OAUTH_REDIRECT_PATH as the
# callback URL in both provider consoles, exactly.
APP_BASE_URL=http://localhost:3000
# OAUTH_REDIRECT_PATH=/api/connectors/oauth/callback
# Fernet key(s) that encrypt stored provider tokens. Comma-separated: the first encrypts,
# all decrypt (rotation). Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional tuning (defaults shown)
# CONNECTOR_TOOL_SCHEMA_TTL_SECONDS=600
# CONNECTOR_REFRESH_SKEW_SECONDS=300
# CONNECTOR_HTTP_TIMEOUT_SECONDS=10

# ---- Cognito Authentication ----
# Cognito is the sole authentication authority (no local fallback).
# Get these values from your environment owner or dev pool.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REGION=eu-central-1
COGNITO_JWKS_CACHE_TTL_SECONDS=3600

# Require MFA for admin operations. Do not enable until all admins have enrolled.
ADMIN_MFA_REQUIRED=false

# Matches the pool's email-OTP constraint (published by Terraform).
AUTH_EMAIL_MFA_ENABLED=false

# ---- LLM Provider (Bedrock) ----
# Bedrock uses AWS credential chain; set AWS_PROFILE in your shell:
#   $env:AWS_PROFILE = "your-profile"
#   aws sso login
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
BEDROCK_INFERENCE_PROFILE_ID=eu.anthropic.claude-haiku-5-5

# Optional: Direct Anthropic API key (Bedrock takes precedence).
# ANTHROPIC_API_KEY=

# ---- Observability ----
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
