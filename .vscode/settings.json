      "apiRoot": "http://localhost:8000",
      "wsRoot": "ws://localhost:8000",
      "loginEmail": "{your_email_here}",
      "loginPassword": "{your_password_here}",
      "jwt": "{your_jwt_token_here}",
      "flowinApiKey": "flowin_replace_with_real_key",
