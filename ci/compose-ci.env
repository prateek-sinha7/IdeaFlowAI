# PLACEHOLDER-ONLY interpolation values for .github/scripts/ci-compose-config.sh.
#
# Used by that check alone, to render docker-compose.yml and
# docker-compose.prod.yml with `docker compose config`. It defines exactly the
# variables those files reference WITHOUT a default; every value contains
# `ci-placeholder` and is never a secret, a real resource name, or a credential.
# Hosts get their real values from /etc/velocityai/app.env, never from here.
# backend/tests/unit/tools/ci/test_ci_graph_contracts.py asserts both properties.
VELOCITYAI_CW_LOG_GROUP=/velocityai/ci-placeholder/app
