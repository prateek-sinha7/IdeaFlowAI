{
  "schema_version": 1,
  "description": "Security check definitions for matrix jobs",
  "security_checks": {
    "secrets": {
      "producer": "security[secrets]",
      "description": "Full-history gitleaks secret scanning",
      "argv": [
        "gitleaks",
        "detect",
        "--redact",
        "--no-banner",
        "-v",
        "--config",
        "ci/gitleaks.toml",
        "-i",
        "ci/gitleaksignore",
        "--source",
        "."
      ],
      "timeout_seconds": 600,
      "required": true,
      "outputs": {
        "json": "ci-results/gitleaks-report.json",
        "log": "ci-results/gitleaks.log"
      }
    },
    "backend-deps": {
      "producer": "security[backend-deps]",
      "description": "Python dependency audit with pip-audit",
      "working_directory": "backend",
      "argv": [
        "uv",
        "run",
        "--frozen",
        "pip-audit",
        "--desc",
        "--format",
        "json"
      ],
      "timeout_seconds": 600,
      "required": true,
      "outputs": {
        "json": "../ci-results/pip-audit-report.json",
        "log": "../ci-results/pip-audit.log"
      },
      "policy": {
        "high_critical_threshold": 0,
        "fail_on_unavailable_severity": true,
        "description": "Zero High/Critical software vulnerabilities regardless of fix availability"
      }
    },
    "frontend-deps": {
      "producer": "security[frontend-deps]",
      "description": "NPM dependency audit",
      "working_directory": "frontend",
      "argv": [
        "npm",
        "audit",
        "--audit-level=high"
      ],
      "timeout_seconds": 600,
      "required": true,
      "outputs": {
        "json": "../ci-results/npm-audit-report.json",
        "log": "../ci-results/npm-audit.log"
      },
      "policy": {
        "high_critical_threshold": 0,
        "description": "Zero High/Critical software vulnerabilities"
      }
    },
    "iac": {
      "producer": "security[iac]",
      "description": "Infrastructure-as-code validation",
      "terraform_roots": [
        "infra/terraform/app",
        "infra/terraform/bootstrap",
        "infra/terraform/foundation",
        "infra/terraform/localstack",
        "infra/terraform/shared",
        "infra/terraform/velocityai-alb"
      ],
      "checks": [
        {
          "id": "terraform-fmt",
          "description": "Terraform code formatting",
          "argv": ["terraform", "fmt", "-check", "-recursive"],
          "per_root": false,
          "timeout_seconds": 300
        },
        {
          "id": "terraform-validate",
          "description": "Terraform configuration validation (backend disabled)",
          "argv": ["terraform", "validate"],
          "per_root": true,
          "env": {
            "TF_BACKEND": "false"
          },
          "timeout_seconds": 300
        },
        {
          "id": "tflint",
          "description": "Terraform linter",
          "argv": ["tflint", "--recursive"],
          "per_root": false,
          "timeout_seconds": 300
        },
        {
          "id": "checkov",
          "description": "Infrastructure policy checks",
          "argv": [
            "checkov",
            "--framework",
            "terraform",
            "--directory",
            "infra/terraform",
            "--config-file",
            "ci/checkov.yaml"
          ],
          "timeout_seconds": 600
        },
        {
          "id": "trivy-config",
          "description": "Trivy configuration and vulnerability scan",
          "argv": [
            "trivy",
            "config",
            "--severity",
            "CRITICAL,HIGH",
            "--exit-code",
            "1",
            "infra/terraform"
          ],
          "timeout_seconds": 600
        }
      ],
      "required": true
    }
  }
}
