# ============================================================
# DEVELOPMENT (Personal Laptop — AWS Bedrock)
# ============================================================
# Drives your local backend through AWS Bedrock. Auth comes from the boto3
# default credential chain — i.e. ~/.aws/credentials, AWS_PROFILE, or any
# other source boto3 understands. There is no API key.
#
# If your laptop has no AWS credentials, agent calls fail at runtime with a
# botocore error (NoCredentialsError / AccessDeniedException). The backend
# itself still boots — Settings only requires AWS_REGION + BEDROCK_MODEL_ID.

ENV=development

# AWS Bedrock — get the model id from `aws bedrock list-foundation-models`
# (or just leave the default below; the EU cross-region inference profile
# routes invocations between EU regions transparently).
AWS_PROFILE=flowin-dev
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql://ideaflow:password@localhost:5432/ideaflow

# Redis (via Docker)
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=dev-secret-change-this-to-random-string
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
