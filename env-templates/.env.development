# ============================================================
# DEVELOPMENT (Personal Laptop — Anthropic API Key)
# ============================================================
# Uses your personal Anthropic API key for real Claude responses.
# PostgreSQL via Docker, Redis for caching.

ENV=development
LLM_PROVIDER=anthropic

# Anthropic API (get your key from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql://ideaflow:password@localhost:5432/ideaflow

# Redis (via Docker)
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=dev-secret-change-this-to-random-string
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ============================================================
# Optional: switch local dev to AWS Bedrock for parity testing
# ============================================================
# Uncomment the block below (and comment the LLM_PROVIDER=anthropic line above)
# to drive your local backend through AWS Bedrock instead of the Anthropic API.
# Auth comes from the boto3 default credential chain — i.e. ~/.aws/credentials
# or the AWS_PROFILE you set here.
#
# LLM_PROVIDER=bedrock
# AWS_PROFILE=flowin-dev
# AWS_REGION=eu-central-1
# BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
