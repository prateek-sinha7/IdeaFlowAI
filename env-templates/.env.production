# ============================================================
# PRODUCTION (AWS — Bedrock)
# ============================================================
# Uses AWS Bedrock for Claude access (no API key needed).
# Authenticates via the boto3 default credential chain — i.e. the EC2/ECS
# instance-profile IAM role in production.
#
# Recent renames (keep these aligned with backend/app/core/config.py):
#   AI_PROVIDER         → LLM_PROVIDER
#   AWS_BEDROCK_MODEL_ID → BEDROCK_MODEL_ID
#
# Single-EC2 deployment (per docs/SIMPLE_AWS_DEPLOYMENT.md) — Postgres runs
# on the same host on 127.0.0.1:5432; no RDS/ElastiCache.

ENV=production
LLM_PROVIDER=bedrock

# AWS Bedrock Configuration
AWS_REGION=eu-central-1
# Cross-region inference profile is the safest default for eu-central-1.
# Verify availability with:
#   aws bedrock list-foundation-models --region eu-central-1
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Database (single-host Postgres on the EC2 instance)
DATABASE_URL=postgresql://flowin:CHANGE_ME@127.0.0.1:5432/flowin

# Security (use AWS Secrets Manager / SSM Parameter Store in real production)
SECRET_KEY=GENERATE-A-64-CHAR-RANDOM-STRING-HERE
ACCESS_TOKEN_EXPIRE_HOURS=12

# CORS (your production domain)
CORS_ORIGINS=["https://ideaflow.yourdomain.com","https://www.ideaflow.yourdomain.com"]
