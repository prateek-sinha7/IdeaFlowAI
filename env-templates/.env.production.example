# Flowin backend — production environment reference
#
# Provision real values through the approved secret/configuration store. Never
# commit a completed production env file, credentials, or a database URL with
# real credentials. The on-host secrets loader writes the deployed app.env.

ENV=production
SECRET_KEY=CHANGE_ME_generate_a_cryptographically_random_32_plus_character_value
DATABASE_URL=postgresql+psycopg://<postgres-user>:<postgres-password>@127.0.0.1:5432/velocityai
CORS_ORIGINS=["https://app.example.com"]
RUNS_ROOT=/app/runs
PUBLIC_BASE_URL=https://app.example.com

# Cognito is mandatory outside development.
COGNITO_USER_POOL_ID=<region>_<pool-id>
COGNITO_CLIENT_ID=<app-client-id>
COGNITO_CLIENT_SECRET=CHANGE_ME_source_from_secret_manager
COGNITO_REGION=eu-central-1
COGNITO_JWKS_CACHE_TTL_SECONDS=3600
ADMIN_MFA_REQUIRED=true
AUTH_EMAIL_MFA_ENABLED=false

# Bedrock uses the workload's IAM role; do not put AWS credentials here.
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_INFERENCE_PROFILE_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0

LOG_LEVEL_APP=WARNING
LOG_FORMAT=json
LANGSMITH_TRACING=false
