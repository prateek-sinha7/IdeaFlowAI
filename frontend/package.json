{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest --run --coverage",
    "test:no-coverage": "vitest --run",
    "lint": "eslint --max-warnings 0",
    "lint:prune": "eslint --prune-suppressions",
    "lint:suppress": "eslint --suppress-all",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test --project=mocked",
    "e2e:headed": "playwright test --project=mocked --headed",
    "e2e:ui": "playwright test --project=mocked --ui",
    "e2e:live": "playwright test --project=live",
    "e2e:report": "playwright show-report e2e/.report"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "jszip": "3.10.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/highlight": "1.2.3",
    "@reduxjs/toolkit": "2.12.0",
    "axios": "1.19.0",
    "lucide-react": "1.14.0",
    "mermaid": "11.17.2",
    "motion": "12.38.0",
    "next": "16.3.4",
    "pptxgenjs": "3.12.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "5.6.0",
    "react-markdown": "10.1.0",
    "react-redux": "9.3.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "fast-check": "4.7.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "rolldown": "1.2.5"
  }
}
