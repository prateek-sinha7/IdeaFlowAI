# Flowin Frontend — Local Development
#
# Copy to frontend/.env.local (do not commit).
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.

# API base URL for REST calls. Empty (default) = same-origin proxy (nginx dev).
# For native backend at localhost:8000, set to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
