{
  "description": "Shared cases for canonical.py and canonicalManifest.ts. expected, expected_json and expected_hash come from the Python implementation (design 3.10.8, G-34). Regenerate from backend/ only when the canonical form changes on purpose.",
  "cases": [
    {
      "name": "empty manifest",
      "manifest": {},
      "expected": {},
      "expected_json": "{}",
      "expected_hash": "44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
    },
    {
      "name": "nulls dropped from objects at any depth, kept in lists",
      "manifest": {
        "name": "wf",
        "description": null,
        "steps": [
          {
            "agent": "a",
            "model": null,
            "meta": {
              "x": null,
              "y": [
                null,
                {
                  "z": null,
                  "w": 1
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "name": "wf",
        "steps": [
          {
            "agent": "a",
            "meta": {
              "y": [
                null,
                {
                  "w": 1
                }
              ]
            }
          }
        ]
      },
      "expected_json": "{\"name\":\"wf\",\"steps\":[{\"agent\":\"a\",\"meta\":{\"y\":[null,{\"w\":1}]}}]}",
      "expected_hash": "a8e543d76c0a69a4c4f080db3c4db7c5dc1a826381ba8aba4e87bea94d839f9a"
    },
    {
