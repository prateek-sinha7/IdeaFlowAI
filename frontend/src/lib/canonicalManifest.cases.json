            "agent": "a",
            "route": {
              "outcomes": {
                "ok": {
                  "trigger": "step",
                  "target": "c"
                },
                "bad": {
                  "trigger": "gate",
                  "target": "b"
                },
                "none": {
                  "trigger": "step",
                  "target": ""
                },
                "odd": "not-a-mapping"
              }
            }
