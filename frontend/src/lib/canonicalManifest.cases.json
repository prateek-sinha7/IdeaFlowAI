      "expected_json": "{\"steps\":[{\"agent\":\"a\",\"route\":{\"outcomes\":{\"bad\":{\"target\":\"b\",\"trigger\":\"gate\"},\"none\":{\"target\":\"\",\"trigger\":\"step\"},\"odd\":\"not-a-mapping\",\"ok\":{\"target\":\"c\",\"trigger\":\"step\"}}}},{\"agent\":\"b\"},{\"agent\":\"c\"},{\"agent\":\"d\"}]}",
      "expected_hash": "91bf2f3e4b85647f2c3bb08b138081497a62a813c4af070be1550eaccc7afdf3"
