# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright e2e run artifacts (the suite + fixtures ARE committed; outputs are not)
/test-results/
/e2e/.report/
/playwright/.cache/

# fidelity harness outputs (scripts + README committed; shots + gallery are not)
/e2e/fidelity/shots/
/e2e/fidelity/gallery.html
# Phase 40 shell fidelity outputs
/e2e/fidelity/shots-shell/
/e2e/fidelity/gallery-shell.html
