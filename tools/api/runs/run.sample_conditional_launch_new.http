### Conditional Gate — cross-workflow trigger/divert (spec 014 example A3)
#
# Tests a conditional gate that diverts to a different workflow:
# greet -> decide (conditional gate, outcomes: divert -> {trigger: workflow, target: sample_conditional_target})
#
# THIS RUN STOPS AT THE DIVERT — there is no pipeline_complete. A NEW run (sample_conditional_target)
# is launched as a child. The terminal event is pipeline_diverted (R-20).
#
# Assertions:
# 1. Stream resolves on pipeline_diverted event (not pipeline_complete)
# 2. Capture diverted_to_run_id from the event
# 3. GET /api/runs/{id} shows status="diverted", diverted_at_step_id="decide"
# 4. GET /api/runs/{diverted_to_run_id} shows parent_run_id={id}, pipeline_type=sample_conditional_target
# 5. (Optional) Stream the diverted-to run to completion and verify output.txt
#
# Run with: httpyac send --all -e local --output none tools/api/runs/run.sample_conditional_launch_new.http
# Or via the wrapper (also saves logs/artifacts): ./run-http.sh sample_conditional_launch_new

### 1. Login
POST {{apiRoot}}/api/auth/login
Content-Type: application/json

{
	"email": "{{loginEmail}}",
	"password": "{{loginPassword}}"
}

{{
	const apiLine = require('./lib/api-line.js');
	exports.jwt = response.parsedBody.token;
	apiLine('POST /api/auth/login -> ' + response.statusCode + ' ' + response.parsedBody.user.email);
}}

### 2. Launch — launch_new workflow. No agent_ids.
{{
	const apiLine = require('./lib/api-line.js');
	// No agent_ids here, deliberately: the launch endpoint validates any supplied agent_ids
	// against allowed_custom_agent_ids(), which does not know the synthetic
	// [instance_id]s used by these fixtures (greet, decide).
	// Omitting the key makes the backend source the roster from the compiled plan instead
	// (see backend/app/api/run_commands.py). Do not "helpfully" add agent_ids back.
	const payload = {
		pipeline_type: "sample_conditional_launch_new",
		message: "Hi, hello!",
	};
	exports.launchBody = JSON.stringify(payload);
}}
POST {{apiRoot}}/api/runs
Authorization: Bearer {{jwt}}
Content-Type: application/json

{{launchBody}}

{{
	const apiLine = require('./lib/api-line.js');
	if (response.statusCode >= 400) {
		apiLine('FAILED: ' + JSON.stringify(response.parsedBody), 'error');
	} else {
		exports.runId = response.parsedBody.run_id;
		apiLine('POST /api/runs -> ' + response.statusCode + ' run=' + exports.runId);
	}
}}

### 3. Stream events over SSE, wait for divert (NOT pipeline_complete)
SSE {{apiRoot}}/api/runs/{{runId}}/events/stream
Authorization: Bearer {{jwt}}
Event: message

{{@streaming
	const apiLine = require('./lib/api-line.js');

	await new Promise((resolve) => {
		let done = false;
		const finish = () => { if (!done) { done = true; resolve(); } };

		let diverted_to_run_id = null;
		let terminal_event = null;

		$requestClient.addEventListener('message', (evt) => {
			const [name, msg] = evt.detail;
			if (name === 'error') { finish(); return; }

			let data; try { data = JSON.parse(msg.body); } catch { data = null; }
			if (!data) return;

			const type = data.type;
			const d = data.data || {};

			if (type === 'agent_start') {
				apiLine('agent_start: ' + d.agent_id);
			} else if (type === 'agent_complete') {
				apiLine('agent_complete: ' + d.agent_id);
			} else if (type === 'pipeline_diverted') {
				apiLine('✓ pipeline_diverted event received');
				diverted_to_run_id = d.diverted_to_run_id;
				terminal_event = 'pipeline_diverted';
				apiLine('  diverted_to_run_id: ' + diverted_to_run_id);
				apiLine('  diverted_to_workflow: ' + d.diverted_to_workflow);
				exports.diverted_to_run_id = diverted_to_run_id;
				finish();
			} else if (['pipeline_complete', 'pipeline_failed', 'pipeline_cancelled', 'budget_aborted', 'error'].includes(type)) {
				apiLine('✗ Expected pipeline_diverted but got ' + type, 'error');
				terminal_event = type;
				finish();
			}
		});

		$requestClient.addEventListener('disconnect', finish);
		$requestClient.addEventListener('error', finish);
		setTimeout(finish, 5 * 60 * 1000);
	});
}}

### 4. Verify original run status
GET {{apiRoot}}/api/runs/{{runId}}
Authorization: Bearer {{jwt}}

{{
	const apiLine = require('./lib/api-line.js');
	const run = response.parsedBody;
	const status = run.status;
	const diverted_at = run.diverted_at_step_id;

	apiLine('Original run status: ' + status);
	if (status === 'diverted') {
		apiLine('✓ status = diverted');
	} else {
		apiLine('✗ Expected status=diverted, got ' + status, 'error');
	}

	apiLine('diverted_at_step_id: ' + diverted_at);
	if (diverted_at === 'decide') {
		apiLine('✓ diverted_at_step_id = decide');
	} else {
		apiLine('✗ Expected diverted_at_step_id=decide, got ' + diverted_at, 'error');
	}
}}

### 5. Verify child run exists and has correct parent link
GET {{apiRoot}}/api/runs/{{diverted_to_run_id}}
Authorization: Bearer {{jwt}}

{{
	const apiLine = require('./lib/api-line.js');
	const child_run = response.parsedBody;
	const parent_id = child_run.parent_run_id;
	const pipeline = child_run.pipeline_type;

	apiLine('Child run parent_run_id: ' + parent_id);
	if (parent_id === runId) {
		apiLine('✓ parent_run_id matches original run');
	} else {
		apiLine('✗ Expected parent_run_id=' + runId + ', got ' + parent_id, 'error');
	}

	apiLine('Child run pipeline_type: ' + pipeline);
	if (pipeline === 'sample_conditional_target') {
		apiLine('✓ pipeline_type = sample_conditional_target');
	} else {
		apiLine('✗ Expected pipeline_type=sample_conditional_target, got ' + pipeline, 'error');
	}
}}

### 6. (Optional) Stream the diverted-to run to completion
SSE {{apiRoot}}/api/runs/{{diverted_to_run_id}}/events/stream
Authorization: Bearer {{jwt}}
Event: message

{{@streaming
	const apiLine = require('./lib/api-line.js');

	await new Promise((resolve) => {
		let done = false;
		const finish = () => { if (!done) { done = true; resolve(); } };

		$requestClient.addEventListener('message', (evt) => {
			const [name, msg] = evt.detail;
			if (name === 'error') { finish(); return; }

			let data; try { data = JSON.parse(msg.body); } catch { data = null; }
			if (!data) return;

			const type = data.type;
			const d = data.data || {};

			if (type === 'agent_start') {
				apiLine('child: agent_start: ' + d.agent_id);
			} else if (type === 'agent_complete') {
				apiLine('child: agent_complete: ' + d.agent_id);
			} else if (type === 'pipeline_complete') {
				apiLine('✓ child pipeline_complete reached');
				finish();
			} else if (['pipeline_failed', 'pipeline_cancelled', 'budget_aborted', 'error'].includes(type)) {
				apiLine('child: ' + type, 'error');
				finish();
			}
		});

		$requestClient.addEventListener('disconnect', finish);
		$requestClient.addEventListener('error', finish);
		setTimeout(finish, 5 * 60 * 1000);
	});
}}

### 7. Fetch child run artifacts
GET {{apiRoot}}/api/runs/{{diverted_to_run_id}}/artifacts?include=content
Authorization: Bearer {{jwt}}

{{
	const apiLine = require('./lib/api-line.js');
	const artifacts = response.parsedBody.artifacts || [];

	let output_txt = null;
	for (const art of artifacts) {
		if (art.name === 'output.txt') {
			output_txt = art.content;
			break;
		}
	}

	if (!output_txt) {
		apiLine('(output.txt artifact not found in child run)');
	} else {
		const content = output_txt.trim();
		apiLine('Child run output.txt: "' + content + '"');
		if (content === 'Welcome to the target workflow!') {
			apiLine('✓ Child run output is correct');
		} else {
			apiLine('✗ Child run output unexpected: ' + content, 'error');
		}
	}
}}
