### prototype (od_prototype alias resolves here) — per-task build pipeline
# IMPORTANT: the run_pipeline WS message below uses pipeline_type
# "od_prototype", not the bare "prototype" alias. Verified live: the
# backend only loads template context (od_context) for the od_* aliases
# (backend/app/api/websocket.py ~line 1710) — bare "prototype" ignores
# template_id entirely and then fails the template-inject ingress guard
# with code "missing_template_context", even with a valid template_id set.
# The frontend always sends od_prototype for this reason. REST discovery
# (GET /api/agents/pipelines/...) still uses "prototype".
#
# IMPORTANT #2: run_pipeline and submit_questionnaire are sent on the SAME
# WebSocket connection below, not two separate WS requests. Verified live:
# a pipeline paused at the clarify gate (questionnaire_ready) can be
# cancelled by the backend if the connection that started it disconnects
# before submit_questionnaire arrives on a new connection — the "paused
# pipeline survives disconnect" contract has a race right at that gate.
# Keeping one connection open for the whole run_pipeline -> clarify ->
# agents flow avoids the race entirely.
# prototype-specify -> prototype-plan -> prototype-analyze -> prototype-build (per-task sub-agents) -> prototype-validate
# Run with: httpyac send --all -e local tools/api/runs/run.prototype.http

### 1. Login
POST {{apiRoot}}/api/auth/login
Content-Type: application/json

{
	"email": "{{loginEmail}}",
	"password": "{{loginPassword}}"
}

{{
	exports.jwt = response.parsedBody.token;
	console.log('logged in as', response.parsedBody.user.email);
}}

### 2. Discovery — agents in this pipeline
GET {{apiRoot}}/api/agents/pipelines/prototype
Authorization: Bearer {{jwt}}

### 3. Discovery — available templates (pick a real template_id)
GET {{apiRoot}}/api/prototype/templates
Authorization: Bearer {{jwt}}

### 4. Discovery — one template's detail
GET {{apiRoot}}/api/prototype/templates/saas-landing
Authorization: Bearer {{jwt}}

### 5. Discovery — available design systems (pick a real design_system_id)
# Note: "linear" (used by tools/api/endpoints/prototype.http elsewhere in this repo) is
# stale — the real id is "linear-app" (verified live against this backend).
GET {{apiRoot}}/api/prototype/design-systems
Authorization: Bearer {{jwt}}

### 6. Run the pipeline, auto-skip clarification, wait for completion — all on one connection
# Note: prototype-specify / prototype-plan are the default Human_Gate agents
# (see AGENT.md `gate: Human_Gate`) — a real run may pause on a
# `review_gate_prompt` event needing `approve_review` in ADDITION to the
# clarify questionnaire. This script only auto-answers the clarify gate; it
# logs a warning and keeps waiting if it hits a review gate instead — send
# the commented approve_review block below on a fresh connection if that happens.
WS {{wsRoot}}/ws/chat?token={{jwt}}

{
	"type": "run_pipeline",
	"pipeline_type": "od_prototype",
	"message": "Build a focused landing page for an AI code review tool aimed at engineering managers.",
	"template_id": "saas-landing",
	"design_system_id": "linear-app",
	"discovery": {
		"audience": "engineering managers",
		"cta": "Start free trial"
	}
}

{{@streaming
	await new Promise((resolve) => {
		let done = false;
		let pipelineRunId = null;
		const finish = () => { if (!done) { done = true; resolve(); } };
		$requestClient.nativeClient.on('message', (raw) => {
			let data; try { data = JSON.parse(raw.toString()); } catch { data = null; }
			if (!data) return;
			console.log('WS <-', data.type);
			const runId = data.data && data.data.pipeline_run_id;
			if (runId && !pipelineRunId) {
				pipelineRunId = runId;
				exports.pipelineRunId = runId;
			}
			if (data.type === 'questionnaire_ready') {
				console.log('-> auto-answering clarify gate with skip_clarification: true');
				$requestClient.nativeClient.send(JSON.stringify({
					type: 'submit_questionnaire',
					pipeline_run_id: pipelineRunId,
					responses: [],
					skip_clarification: true,
				}));
			}
			if (data.type && data.type.startsWith('review_gate')) {
				console.log('!! paused on a Human_Gate — this script does not auto-approve; see approve_review below');
			}
			if (['pipeline_complete', 'pipeline_failed', 'pipeline_cancelled', 'error'].includes(data.type)) {
				finish();
			}
		});
		$requestClient.nativeClient.on('close', finish);
		$requestClient.nativeClient.on('error', finish);
		setTimeout(finish, 15 * 60 * 1000);
	});
}}

### 7. (Optional) Approve a Human_Gate review, on a fresh connection, if the run paused on one
# gate_key comes from the review_gate_prompt event's data.gate_key.
# WS {{wsRoot}}/ws/chat?token={{jwt}}
#
# {
# 	"type": "approve_review",
# 	"pipeline_run_id": "{{pipelineRunId}}",
# 	"gate_key": "prototype-specify",
# 	"approved": true,
# 	"action": "approve"
# }

### 8. Inspect the run
GET {{apiRoot}}/api/runs/{{pipelineRunId}}
Authorization: Bearer {{jwt}}

### 9. Durable event replay
GET {{apiRoot}}/api/runs/{{pipelineRunId}}/events
Authorization: Bearer {{jwt}}

### 10. Typed artifact tree
GET {{apiRoot}}/api/runs/{{pipelineRunId}}/artifacts?include=content
Authorization: Bearer {{jwt}}

{{
	const fs = require('fs');
	const path = require('path');
	const body = response.parsedBody;
	const deliverable = (body.artifacts || []).find(a => a.kind === 'deliverable');
	if (!deliverable) {
		console.log('No "deliverable" artifact yet -- the run may not have completed, or this pipeline has no single-file deliverable.');
	} else {
		const outDir = path.join(path.dirname(httpFile.fileName), 'artifacts', 'od_prototype');
		fs.mkdirSync(outDir, { recursive: true });
		const trimmed = deliverable.content.trim().toLowerCase();
		const ext = trimmed.startsWith('<!doctype html') || trimmed.startsWith('<html') ? 'html' : 'txt';
		const outPath = path.join(outDir, `${pipelineRunId}.${ext}`);
		fs.writeFileSync(outPath, deliverable.content, 'utf-8');
		console.log('Saved deliverable to', outPath, '(' + deliverable.content.length + ' bytes)');
	}
}}

### 11. (Optional) Revision — chained off the run above
# WS {{wsRoot}}/ws/chat?token={{jwt}}
#
# {
# 	"type": "run_revision",
# 	"parent_run_id": "{{pipelineRunId}}",
# 	"target_artifact_type": "prototype",
# 	"instruction": "Add a pricing section with three tiers below the hero."
# }
