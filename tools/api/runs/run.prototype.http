### prototype (od_prototype alias resolves here) — per-task build pipeline
# IMPORTANT: the launch payload below uses pipeline_type "od_prototype", not
# the bare "prototype" alias. Verified live: the backend only loads template
# context (od_context) when pipeline_type resolves through the dedicated od_*
# label (backend/app/api/launch_context.py::resolve_launch_od_context) — bare
# "prototype" ignores template_id entirely and then fails the template-inject
# ingress guard with code "missing_template_context", even with a valid
# template_id set. The frontend always sends od_prototype for this reason.
# REST discovery (GET /api/agents/pipelines/...) still uses "prototype".
#
# NOTE: the old WebSocket run_pipeline/submit_questionnaire flow (/ws/chat) was
# retired — the backend now launches a run over plain REST
# (POST /api/runs) and streams its events back over SSE
# (GET /api/runs/{id}/events/stream). The two are fully decoupled transports
# (unlike the old WS message channel), so there's no more "must share one
# connection" race: the launch, the SSE stream, and the clarify-answer POST
# are three independent HTTP calls.
# prototype-specify -> prototype-plan -> prototype-analyze -> prototype-build (per-task sub-agents) -> prototype-validate
# Run with: httpyac send --all -e local tools/api/runs/run.prototype.http

### 1. Login
POST {{apiRoot}}/api/auth/login
Content-Type: application/json

{
	"email": "{{loginEmail}}",
	"password": "{{loginPassword}}"
}

{{
	exports.jwt = response.parsedBody.token;
	console.log('logged in as', response.parsedBody.user.email);
}}

### 2. Discovery — agents in this pipeline
GET {{apiRoot}}/api/agents/pipelines/prototype
Authorization: Bearer {{jwt}}

### 3. Discovery — available templates (pick a real template_id)
GET {{apiRoot}}/api/prototype/templates
Authorization: Bearer {{jwt}}

### 4. Discovery — one template's detail
GET {{apiRoot}}/api/prototype/templates/saas-landing
Authorization: Bearer {{jwt}}

### 5. Discovery — available design systems (pick a real design_system_id)
# Note: "linear" (used by tools/api/endpoints/prototype.http elsewhere in this repo) is
# stale — the real id is "linear-app" (verified live against this backend).
GET {{apiRoot}}/api/prototype/design-systems
Authorization: Bearer {{jwt}}

### 6. Launch the run
POST {{apiRoot}}/api/runs
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"pipeline_type": "od_prototype",
	"message": "Build a focused landing page for an AI code review tool aimed at engineering managers.",
	"template_id": "saas-landing",
	"design_system_id": "linear-app",
	"discovery": {
		"audience": "engineering managers",
		"cta": "Start free trial"
	}
}

{{
	exports.pipelineRunId = response.parsedBody.run_id;
	console.log('launched run', exports.pipelineRunId);
}}

### 7. Stream events over SSE, auto-skip clarification, wait for completion
# Note: prototype-specify / prototype-plan are the default Human_Gate agents
# (see AGENT.md `gate: Human_Gate`) — a real run may pause on a
# `review_gate_ready` event needing a gate POST in ADDITION to the clarify
# questionnaire. This script only auto-answers the clarify gate; it logs a
# warning and keeps waiting if it hits a review gate instead — send the
# commented gate POST below once you have a real gate_key if that happens.
SSE {{apiRoot}}/api/runs/{{pipelineRunId}}/events/stream
Authorization: Bearer {{jwt}}
Event: message

{{@streaming
	await new Promise((resolve) => {
		let done = false;
		let answered = false;
		const finish = () => { if (!done) { done = true; resolve(); } };
		$requestClient.addEventListener('message', async (evt) => {
			const [name, msg] = evt.detail;
			if (name === 'error') {
				console.error('SSE error', msg && msg.body);
				finish();
				return;
			}
			let data; try { data = JSON.parse(msg.body); } catch { data = null; }
			if (!data) return;
			console.log('SSE <-', data.type);
			if (data.type === 'questionnaire_ready' && !answered) {
				answered = true;
				console.log('-> auto-answering clarify gate with skip_clarification: true');
				try {
					await fetch(`${apiRoot}/api/runs/${pipelineRunId}/answers`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${jwt}` },
						body: JSON.stringify({ responses: [], skip_clarification: true }),
					});
				} catch (e) {
					console.error('POST /answers failed', e);
				}
			}
			if (data.type === 'review_gate_ready') {
				console.log('!! paused on a Human_Gate — this script does not auto-approve; see the gate POST below');
			}
			if (['pipeline_complete', 'pipeline_failed', 'pipeline_cancelled', 'budget_aborted', 'error'].includes(data.type)) {
				finish();
			}
		});
		$requestClient.addEventListener('disconnect', finish);
		setTimeout(finish, 15 * 60 * 1000);
	});
}}

### 8. (Optional) Approve a Human_Gate review, if the run paused on one
# gate_key comes from the review_gate_ready event's data.gate_key.
# POST {{apiRoot}}/api/runs/{{pipelineRunId}}/gate
# Authorization: Bearer {{jwt}}
# Content-Type: application/json
#
# {
# 	"gate_key": "prototype-specify",
# 	"action": "approve",
# 	"approved": true
# }

### 9. Inspect the run
GET {{apiRoot}}/api/runs/{{pipelineRunId}}
Authorization: Bearer {{jwt}}

### 10. Durable event replay (history poll — distinct from the live /events/stream SSE above)
GET {{apiRoot}}/api/runs/{{pipelineRunId}}/events
Authorization: Bearer {{jwt}}

### 11. Typed artifact tree
GET {{apiRoot}}/api/runs/{{pipelineRunId}}/artifacts?include=content
Authorization: Bearer {{jwt}}

{{
	const fs = require('fs');
	const path = require('path');
	const body = response.parsedBody;
	const deliverable = (body.artifacts || []).find(a => a.kind === 'deliverable');
	if (!deliverable) {
		console.log('No "deliverable" artifact yet -- the run may not have completed, or this pipeline has no single-file deliverable.');
	} else {
		const outDir = path.join(path.dirname(httpFile.fileName), 'artifacts', 'od_prototype');
		fs.mkdirSync(outDir, { recursive: true });
		const trimmed = deliverable.content.trim().toLowerCase();
		const ext = trimmed.startsWith('<!doctype html') || trimmed.startsWith('<html') ? 'html' : 'txt';
		const outPath = path.join(outDir, `${pipelineRunId}.${ext}`);
		fs.writeFileSync(outPath, deliverable.content, 'utf-8');
		console.log('Saved deliverable to', outPath, '(' + deliverable.content.length + ' bytes)');
	}
}}

### 12. (Optional) Revision — chained off the run above
# POST {{apiRoot}}/api/runs/{{pipelineRunId}}/revisions
# Authorization: Bearer {{jwt}}
# Content-Type: application/json
#
# {
# 	"target_artifact_type": "prototype",
# 	"instruction": "Add a pricing section with three tiers below the hero."
# }
