### ppt (alias of od_ppt) — deck generation pipeline
# IMPORTANT: the run_pipeline WS message below uses pipeline_type "od_ppt",
# not the bare "ppt" alias. Verified live: the backend only loads template
# context (od_context) for the od_* aliases (backend/app/api/websocket.py
# ~line 1710) — bare "ppt" ignores template_id entirely and then fails the
# template-inject ingress guard with code "missing_template_context", even
# with a valid template_id set. The frontend always sends od_ppt for this
# reason. REST discovery (GET /api/agents/pipelines/...) still uses "ppt".
#
# IMPORTANT #2: run_pipeline and submit_questionnaire are sent on the SAME
# WebSocket connection below, not two separate WS requests. Verified live:
# a pipeline paused at the clarify gate (questionnaire_ready) can be
# cancelled by the backend if the connection that started it disconnects
# before submit_questionnaire arrives on a new connection — the "paused
# pipeline survives disconnect" contract has a race right at that gate.
# Keeping one connection open for the whole run_pipeline -> clarify ->
# agents flow avoids the race entirely.
# od-ppt-brief-analyst -> od-ppt-composer -> od-ppt-validator
# Run with: httpyac send --all -e local tools/api/runs/run.ppt.http

### 1. Login
POST {{apiRoot}}/api/auth/login
Content-Type: application/json

{
	"email": "{{loginEmail}}",
	"password": "{{loginPassword}}"
}

{{
	console.clear();
	console.log("Logging in as", request.body, "...");
	if (!response.statusCode || response.statusCode < 200 || response.statusCode >= 300) {
		console.error('Login failed:', response.statusCode, response.statusText, response.parsedBody);
	} else {	
	console.log('Login successful:', response.parsedBody);
	exports.jwt = response.parsedBody.token;
	console.log('logged in as', response.parsedBody.user.email);
	console.log("jwt:", exports.jwt);
	}
}}

### 2. Discovery — agents in this pipeline
GET {{apiRoot}}/api/agents/pipelines/od_ppt
Authorization: Bearer {{jwt}}

### 3. Discovery — available PPT templates (pick a real template_id)
# od-ppt-brief-analyst / od-ppt-composer declare template injection — the run
# requires template_id (or custom_template_body) or it fails immediately with
# "missing_template_context" (verified live against this backend).
GET {{apiRoot}}/api/ppt/templates
Authorization: Bearer {{jwt}}

### 4. Run the pipeline, auto-skip clarification, wait for completion — all on one connection
WS {{wsRoot}}/ws/chat?token={{jwt}}

{
	"type": "run_pipeline",
	"pipeline_type": "od_ppt",
	"message": "Create a 10-slide investor pitch deck for a B2B SaaS analytics startup, covering problem, solution, market size, product, traction, and ask.",
	"template_id": "guizang-ppt"
}

{{@streaming
	await new Promise((resolve) => {
		let done = false;
		let pipelineRunId = null;
		const finish = () => { if (!done) { done = true; resolve(); } };
		$requestClient.nativeClient.on('message', (raw) => {
			let data; try { data = JSON.parse(raw.toString()); } catch { data = null; }
			if (!data) return;
			console.log('WS <-', data.type);
			const runId = data.data && data.data.pipeline_run_id;
			if (runId && !pipelineRunId) {
				pipelineRunId = runId;
				exports.pipelineRunId = runId;
			}
			if (data.type === 'questionnaire_ready') {
				console.log('-> auto-answering clarify gate with skip_clarification: true');
				$requestClient.nativeClient.send(JSON.stringify({
					type: 'submit_questionnaire',
					pipeline_run_id: pipelineRunId,
					responses: [],
					skip_clarification: true,
				}));
			}
			if (data.type && data.type.startsWith('review_gate')) {
				console.log('!! paused on a Human_Gate — this script does not auto-approve; see approve_review below');
			}
			if (['pipeline_complete', 'pipeline_failed', 'pipeline_cancelled', 'error'].includes(data.type)) {
				finish();
			}
		});
		$requestClient.nativeClient.on('close', finish);
		$requestClient.nativeClient.on('error', finish);
		setTimeout(finish, 10 * 60 * 1000);
	});
}}

### 5. (Optional) Approve a Human_Gate review, on a fresh connection, if the run paused on one
# Unlike the clarify questionnaire, a review-gate pause is a genuine long
# wait for a human — reusing the original connection isn't practical, so
# this is a separate WS request. gate_key comes from the review_gate_prompt
# event's data.gate_key (od_ppt has no default Human_Gate agents today, so
# this is here for completeness / future pipelines that do).
# WS {{wsRoot}}/ws/chat?token={{jwt}}
#
# {
# 	"type": "approve_review",
# 	"pipeline_run_id": "{{pipelineRunId}}",
# 	"gate_key": "<gate_key from the review_gate_prompt event>",
# 	"approved": true,
# 	"action": "approve"
# }

### 6. Inspect the run
GET {{apiRoot}}/api/runs/{{pipelineRunId}}
Authorization: Bearer {{jwt}}

### 7. Durable event replay
GET {{apiRoot}}/api/runs/{{pipelineRunId}}/events
Authorization: Bearer {{jwt}}

### 8. Typed artifact tree
GET {{apiRoot}}/api/runs/{{pipelineRunId}}/artifacts?include=content
Authorization: Bearer {{jwt}}

{{
	const fs = require('fs');
	const path = require('path');
	const body = response.parsedBody;
	const deliverable = (body.artifacts || []).find(a => a.kind === 'deliverable');
	if (!deliverable) {
		console.log('No "deliverable" artifact yet -- the run may not have completed, or this pipeline has no single-file deliverable.');
	} else {
		// tools/api/runs/artifacts/ppt/ -- same artifacts/ convention as the
		// other *.run.http files, in its own ppt/ subfolder since a run can
		// produce many timestamped decks instead of one per pipeline_run_id.
		const outDir = path.join(path.dirname(httpFile.fileName), 'artifacts', 'ppt');
		fs.mkdirSync(outDir, { recursive: true });
		const trimmed = deliverable.content.trim().toLowerCase();
		// NOTE: od_ppt's deliverable is a self-contained HTML deck, not a real
		// .pptx (see step 9's comment below) -- saved as .html so it actually
		// opens; a .pptx-named file containing HTML would just fail in
		// PowerPoint.
		const ext = trimmed.startsWith('<!doctype html') || trimmed.startsWith('<html') ? 'html' : 'txt';
		const timestamp = process.env.RUN_TIMESTAMP || new Date().toISOString().replace(/[:.]/g, '-');
		const outPath = path.join(outDir, `${timestamp}.${ext}`);
		fs.writeFileSync(outPath, deliverable.content, 'utf-8');
		console.log('Saved deliverable to', outPath, '(' + deliverable.content.length + ' bytes)');
	}
}}

### 9. Export the deck as .pptx -- DOES NOT APPLY to od_ppt (kept for reference)
# This always fails with "Could not find PptxGenJS code" for od_ppt runs --
# verified live, even on a fully successful run. export-pptx looks for a
# ppt-code-generator agent's PptxGenJS source; od_ppt's agents
# (od-ppt-brief-analyst/composer/validator) never produce that -- they
# produce the HTML deck saved by step 8's script instead. Left here only so
# the "why doesn't this work" question doesn't resurface; safe to delete.
# POST {{apiRoot}}/api/runs/export-pptx
# Authorization: Bearer {{jwt}}
# Content-Type: application/json
#
# {
# 	"workflow_id": "{{pipelineRunId}}"
# }

### 10. (Optional) Revision — chained off the run above
# WS {{wsRoot}}/ws/chat?token={{jwt}}
#
# {
# 	"type": "run_revision",
# 	"parent_run_id": "{{pipelineRunId}}",
# 	"target_artifact_type": "ppt",
# 	"instruction": "Make the traction slide more data-heavy with a growth chart callout."
# }
