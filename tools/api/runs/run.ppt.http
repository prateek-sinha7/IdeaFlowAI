### ppt — deck generation pipeline
# UPDATED (composed-workflow-execution signoff): the od_ppt/od_ppt_revision
# launch-label aliases have been REMOVED from this branch's registry
# (agents/registry.py's _OD_ALIAS_BASE comment: "v1 has not shipped, so no
# persisted [runs] are gone from the tier entitlements and from
# SUPPORTED_PIPELINE_TYPES too"). Launching with pipeline_type "od_ppt" now
# 400s with invalid_pipeline_type ("Unsupported pipeline_type: 'od_ppt'") —
# verified live. The bare "ppt" pipeline_type is what actually resolves
# template context now (backend/app/api/launch_context.py::resolve_launch_od_context
# branches on base_pipeline_type == "prototype"/"ppt" directly, not an od_*
# label). REST discovery (GET /api/agents/pipelines/...) also uses "ppt".
#
# NOTE: the old WebSocket run_pipeline/submit_questionnaire flow (/ws/chat) was
# retired — the backend now launches a run over plain REST
# (POST /api/runs) and streams its events back over SSE
# (GET /api/runs/{id}/events/stream). The two are fully decoupled transports
# (unlike the old WS message channel), so there's no more "must share one
# connection" race: the launch, the SSE stream, and the clarify-answer POST
# are three independent HTTP calls.
# od-ppt-brief-analyst -> od-ppt-composer -> od-ppt-validator
# Run with: httpyac send --all -e local tools/api/runs/run.ppt.http

### 1. Login
POST {{apiRoot}}/api/auth/login
Content-Type: application/json

{
	"email": "{{loginEmail}}",
	"password": "{{loginPassword}}"
}

{{
	console.clear();
	console.log("Logging in as", request.body, "...");
	if (!response.statusCode || response.statusCode < 200 || response.statusCode >= 300) {
		console.error('Login failed:', response.statusCode, response.statusText, response.parsedBody);
	} else {
	console.log('Login successful:', response.parsedBody);
	exports.jwt = response.parsedBody.token;
	console.log('logged in as', response.parsedBody.user.email);
	console.log("jwt:", exports.jwt);
	}
}}

### 2. Discovery — agents in this pipeline
GET {{apiRoot}}/api/agents/pipelines/ppt
Authorization: Bearer {{jwt}}

### 3. Discovery — available PPT templates (pick a real template_id)
# od-ppt-brief-analyst / od-ppt-composer declare template injection — the run
# requires template_id (or custom_template_body) or it fails immediately with
# "missing_template_context" (verified live against this backend).
GET {{apiRoot}}/api/ppt/templates
Authorization: Bearer {{jwt}}

### 4. Launch the run
POST {{apiRoot}}/api/runs
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"pipeline_type": "ppt",
	"message": "Create a 10-slide investor pitch deck for a B2B SaaS analytics startup, covering problem, solution, market size, product, traction, and ask.",
	"template_id": "guizang-ppt"
}

{{
	exports.pipelineRunId = response.parsedBody.run_id;
	console.log('launched run', exports.pipelineRunId);
}}

### 5. Stream events over SSE, auto-skip clarification, wait for completion
SSE {{apiRoot}}/api/runs/{{pipelineRunId}}/events/stream
Authorization: Bearer {{jwt}}
Event: message

{{@streaming
	await new Promise((resolve) => {
		let done = false;
		let answered = false;
		const finish = () => { if (!done) { done = true; resolve(); } };
		$requestClient.addEventListener('message', async (evt) => {
			const [name, msg] = evt.detail;
			if (name === 'error') {
				console.error('SSE error', msg && msg.body);
				finish();
				return;
			}
			let data; try { data = JSON.parse(msg.body); } catch { data = null; }
			if (!data) return;
			console.log('SSE <-', data.type);
			if (data.type === 'questionnaire_ready' && !answered) {
				answered = true;
				console.log('-> auto-answering clarify gate with skip_clarification: true');
				try {
					await fetch(`${apiRoot}/api/runs/${pipelineRunId}/answers`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${jwt}` },
						body: JSON.stringify({ responses: [], skip_clarification: true }),
					});
				} catch (e) {
					console.error('POST /answers failed', e);
				}
			}
			if (data.type === 'review_gate_ready') {
				console.log('!! paused on a Human_Gate — this script does not auto-approve; see the gate POST below');
			}
			if (['pipeline_complete', 'pipeline_failed', 'pipeline_cancelled', 'budget_aborted', 'error'].includes(data.type)) {
				finish();
			}
		});
		$requestClient.addEventListener('disconnect', finish);
		setTimeout(finish, 10 * 60 * 1000);
	});
}}

### 6. (Optional) Approve a Human_Gate review, if the run paused on one
# Unlike the clarify questionnaire, a review-gate pause is a genuine human
# wait — od_ppt has no default Human_Gate agents today, so this is here for
# completeness / future pipelines that do. gate_key comes from the
# review_gate_ready event's data.gate_key.
# POST {{apiRoot}}/api/runs/{{pipelineRunId}}/gate
# Authorization: Bearer {{jwt}}
# Content-Type: application/json
#
# {
# 	"gate_key": "<gate_key from the review_gate_ready event>",
# 	"action": "approve",
# 	"approved": true
# }

### 7. Inspect the run
GET {{apiRoot}}/api/runs/{{pipelineRunId}}
Authorization: Bearer {{jwt}}

### 8. Durable event replay (history poll — distinct from the live /events/stream SSE above)
GET {{apiRoot}}/api/runs/{{pipelineRunId}}/events
Authorization: Bearer {{jwt}}

### 9. Typed artifact tree
GET {{apiRoot}}/api/runs/{{pipelineRunId}}/artifacts?include=content
Authorization: Bearer {{jwt}}

{{
	const fs = require('fs');
	const path = require('path');
	const body = response.parsedBody;
	const deliverable = (body.artifacts || []).find(a => a.kind === 'deliverable');
	if (!deliverable) {
		console.log('No "deliverable" artifact yet -- the run may not have completed, or this pipeline has no single-file deliverable.');
	} else {
		// tools/api/runs/artifacts/ppt/ -- same artifacts/ convention as the
		// other *.run.http files, in its own ppt/ subfolder since a run can
		// produce many timestamped decks instead of one per pipeline_run_id.
		const outDir = path.join(path.dirname(httpFile.fileName), 'artifacts', 'ppt');
		fs.mkdirSync(outDir, { recursive: true });
		const trimmed = deliverable.content.trim().toLowerCase();
		// NOTE: od_ppt's deliverable is a self-contained HTML deck, not a real
		// .pptx (see step 10's comment below) -- saved as .html so it actually
		// opens; a .pptx-named file containing HTML would just fail in
		// PowerPoint.
		const ext = trimmed.startsWith('<!doctype html') || trimmed.startsWith('<html') ? 'html' : 'txt';
		const timestamp = process.env.RUN_TIMESTAMP || new Date().toISOString().replace(/[:.]/g, '-');
		const outPath = path.join(outDir, `${timestamp}.${ext}`);
		fs.writeFileSync(outPath, deliverable.content, 'utf-8');
		console.log('Saved deliverable to', outPath, '(' + deliverable.content.length + ' bytes)');
	}
}}

### 10. Export the deck as .pptx -- DOES NOT APPLY to od_ppt (kept for reference)
# This always fails with "Could not find PptxGenJS code" for od_ppt runs --
# verified live, even on a fully successful run. export-pptx looks for a
# ppt-code-generator agent's PptxGenJS source; od_ppt's agents
# (od-ppt-brief-analyst/composer/validator) never produce that -- they
# produce the HTML deck saved by step 9's script instead. Left here only so
# the "why doesn't this work" question doesn't resurface; safe to delete.
# POST {{apiRoot}}/api/runs/export-pptx
# Authorization: Bearer {{jwt}}
# Content-Type: application/json
#
# {
# 	"workflow_id": "{{pipelineRunId}}"
# }

### 11. (Optional) Revision — chained off the run above
# POST {{apiRoot}}/api/runs/{{pipelineRunId}}/revisions
# Authorization: Bearer {{jwt}}
# Content-Type: application/json
#
# {
# 	"target_artifact_type": "ppt",
# 	"instruction": "Make the traction slide more data-heavy with a growth chart callout."
# }
