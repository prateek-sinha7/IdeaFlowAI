### Conditional Gate — condition from a human gate (spec 014 example A4)
#
# Tests a conditional gate reading an earlier HUMAN gate's response:
# greet -> review (human gate, produces: route_decision, PAUSES) -> revise-check (conditional gate,
# condition_agent: review, outcomes: continue->done, revise->greet loop)
#
# This file AUTO-RESOLVES the human gate (unlike other files that leave it commented) so it's
# a full unattended integration test.
#
# Assertions:
# 1. Pipeline pauses at review_gate_ready event
# 2. We auto-resolve with action: "approve", edited_content: {"decision": "continue"}
# 3. Pipeline continues and reaches pipeline_complete
# 4. Log that the gate was resolved
#
# Run with: httpyac send --all -e local --output none tools/api/runs/run.sample_conditional_human_input.http
# Or via the wrapper (also saves logs/artifacts): ./run-http.sh sample_conditional_human_input

### 1. Login
POST {{apiRoot}}/api/auth/login
Content-Type: application/json

{
	"email": "{{loginEmail}}",
	"password": "{{loginPassword}}"
}

{{
	const apiLine = require('./lib/api-line.js');
	exports.jwt = response.parsedBody.token;
	apiLine('POST /api/auth/login -> ' + response.statusCode + ' ' + response.parsedBody.user.email);
}}

### 2. Launch — human input workflow. No agent_ids.
{{
	const apiLine = require('./lib/api-line.js');
	// No agent_ids here, deliberately: the launch endpoint validates any supplied agent_ids
	// against allowed_custom_agent_ids(), which does not know the synthetic
	// [instance_id]s used by these fixtures (greet, review, revise-check, done).
	// Omitting the key makes the backend source the roster from the compiled plan instead
	// (see backend/app/api/run_commands.py). Do not "helpfully" add agent_ids back.
	const payload = {
		pipeline_type: "sample_conditional_human_input",
		message: "Hi, hello!",
	};
	exports.launchBody = JSON.stringify(payload);
}}
POST {{apiRoot}}/api/runs
Authorization: Bearer {{jwt}}
Content-Type: application/json

{{launchBody}}

{{
	const apiLine = require('./lib/api-line.js');
	if (response.statusCode >= 400) {
		apiLine('FAILED: ' + JSON.stringify(response.parsedBody), 'error');
	} else {
		exports.runId = response.parsedBody.run_id;
		apiLine('POST /api/runs -> ' + response.statusCode + ' run=' + exports.runId);
	}
}}

### 3. Stream events over SSE, wait for completion. Auto-resolve human gate.
SSE {{apiRoot}}/api/runs/{{runId}}/events/stream
Authorization: Bearer {{jwt}}
Event: message

{{@streaming
	const apiLine = require('./lib/api-line.js');
	const fetch_fn = typeof fetch !== 'undefined' ? fetch : (...args) => require('node-fetch')(...args);

	await new Promise((resolve) => {
		let done = false;
		const finish = () => { if (!done) { done = true; resolve(); } };

		let gate_resolved = false;
		let pipeline_ended = false;

		$requestClient.addEventListener('message', (evt) => {
			const [name, msg] = evt.detail;
			if (name === 'error') { finish(); return; }

			let data; try { data = JSON.parse(msg.body); } catch { data = null; }
			if (!data) return;

			const type = data.type;
			const d = data.data || {};

			if (type === 'agent_start') {
				apiLine('agent_start: ' + d.agent_id);
			} else if (type === 'agent_complete') {
				apiLine('agent_complete: ' + d.agent_id);
			} else if (type === 'review_gate_ready' && !gate_resolved) {
				// Human gate is ready — auto-resolve it with "continue" decision
				gate_resolved = true;
				apiLine('review_gate_ready detected for ' + d.agent_id);

				// Send gate approval immediately
				fetch_fn(apiRoot + '/api/runs/' + runId + '/gate', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'Authorization': 'Bearer ' + jwt
					},
					body: JSON.stringify({
						gate_key: d.gate_key,
						action: 'approve',
						edited_content: JSON.stringify({ decision: 'continue' })
					})
				}).then(res => {
					apiLine('gate resolve POST -> ' + res.status);
				}).catch(err => {
					apiLine('gate resolve failed: ' + err.message, 'error');
				});
			} else if (type === 'pipeline_complete') {
				apiLine('pipeline_complete reached');
				pipeline_ended = true;
				finish();
			} else if (['pipeline_failed', 'pipeline_cancelled', 'budget_aborted', 'error'].includes(type)) {
				apiLine(type, 'error');
				pipeline_ended = true;
				finish();
			}
		});

		$requestClient.addEventListener('disconnect', finish);
		$requestClient.addEventListener('error', finish);
		setTimeout(finish, 5 * 60 * 1000);
	});

	exports.gate_resolved = gate_resolved;
}}

### 4. GET events history for assertions
GET {{apiRoot}}/api/runs/{{runId}}/events
Authorization: Bearer {{jwt}}

{{
	const apiLine = require('./lib/api-line.js');
	const events = response.parsedBody.events || [];

	// Check for review_gate_ready event
	const gateReady = events.some(e => e.type === 'review_gate_ready');
	if (gateReady) {
		apiLine('✓ review_gate_ready event found');
	} else {
		apiLine('✗ review_gate_ready not found', 'error');
	}

	// Check for pipeline_complete
	const hasComplete = events.some(e => e.type === 'pipeline_complete');
	if (hasComplete) {
		apiLine('✓ pipeline_complete event found');
	} else {
		apiLine('✗ pipeline_complete not found', 'error');
	}

	// Log how many times greet ran (should loop if conditional gate fired)
	const greetCount = events.filter(e => e.type === 'agent_start' && e.data?.agent_id === 'greet').length;
	apiLine('Loop count: greet agent ran ' + greetCount + ' time(s)');
}}

### 5. Fetch artifacts to verify completion
GET {{apiRoot}}/api/runs/{{runId}}/artifacts?include=content
Authorization: Bearer {{jwt}}

{{
	const apiLine = require('./lib/api-line.js');
	const artifacts = response.parsedBody.artifacts || [];

	let draft_txt = null;
	for (const art of artifacts) {
		if (art.name === 'draft.txt') {
			draft_txt = art.content;
			break;
		}
	}

	if (!draft_txt) {
		apiLine('(draft.txt artifact not found — gate may not have been resolved)');
	} else {
		apiLine('draft.txt artifact present: ' + draft_txt.slice(0, 40) + '...');
	}
}}
