### Settings - Get constitution
# Returns {content: null} when nothing has been saved yet.
GET {{apiRoot}}/api/settings/constitution
Authorization: Bearer {{jwt}}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else {
		console.log('OK: constitution content =', body.content === null ? '(none saved)' : body.content.length + ' chars');
	}
}}

### Settings - Set constitution
PUT {{apiRoot}}/api/settings/constitution
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"content": "Always validate security and privacy impacts first."
}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (body.content !== 'Always validate security and privacy impacts first.') {
		console.error('FAIL: expected the content to round-trip, got', body);
	} else {
		console.log('OK: constitution saved (' + body.content.length + ' chars)');
	}
}}

