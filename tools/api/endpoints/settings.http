### Settings - Upsert GitHub PAT
# Validates the PAT against the real GitHub API (GET https://api.github.com/user)
# before persisting — with the placeholder "ghp_replace_me" this is expected
# to fail validation (400), not a defect in this file. Swap in a real PAT to
# exercise the 200 path.
PUT {{apiRoot}}/api/settings/github-pat
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"pat": "ghp_replace_me"
}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ') — set a real {{jwt}} to exercise this assertion');
	} else if (sc === 400) {
		console.log('OK (expected with the placeholder PAT): GitHub rejected it (400)');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200 or 400, got', sc, body);
	} else if (typeof body.last_4 !== 'string') {
		console.error('FAIL: expected {github_username, scopes, last_4, created_at, updated_at} shape, got', body);
	} else {
		console.log('OK: PAT saved for GitHub user', body.github_username);
	}
}}

### Settings - Upsert GitHub PAT (empty string, expect 422)
PUT {{apiRoot}}/api/settings/github-pat
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"pat": "   "
}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 422) {
		console.error('FAIL: expected 422 for a blank PAT, got', sc, response.parsedBody);
	} else {
		console.log('OK: blank PAT correctly rejected (422)');
	}
}}

### Settings - Get GitHub PAT status
# Returns 200 with a null body when no PAT is saved — there's no 404 here.
GET {{apiRoot}}/api/settings/github-pat
Authorization: Bearer {{jwt}}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (body === null) {
		console.log('OK: no GitHub PAT saved (200, null body)');
	} else if (typeof body.last_4 !== 'string') {
		console.error('FAIL: expected null or {github_username, scopes, last_4, ...}, got', body);
	} else {
		console.log('OK: GitHub PAT saved for', body.github_username, '(...' + body.last_4 + ')');
	}
}}

### Settings - Delete GitHub PAT
# Idempotent — 204 whether or not a PAT was actually saved.
DELETE {{apiRoot}}/api/settings/github-pat
Authorization: Bearer {{jwt}}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 204) {
		console.error('FAIL: expected 204, got', sc, response.parsedBody);
	} else {
		console.log('OK: GitHub PAT deleted (204, idempotent)');
	}
}}

### Settings - Create API key
POST {{apiRoot}}/api/settings/api-keys
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"name": "Local IDE Key"
}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 201) {
		console.error('FAIL: expected 201, got', sc, body);
	} else if (typeof body.token !== 'string' || !body.token.startsWith('flowin_')) {
		console.error('FAIL: expected {id, name, token, token_prefix, created_at} with a flowin_-prefixed token, got', body);
	} else {
		console.log('OK: created API key', body.id, '(' + body.token_prefix + '...) — set {{apiKeyId}} to this id to exercise the Revoke request below');
	}
}}

### Settings - List API keys
GET {{apiRoot}}/api/settings/api-keys
Authorization: Bearer {{jwt}}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (!Array.isArray(body) || body.some(k => 'token' in k)) {
		console.error('FAIL: expected an array of summaries with NO plaintext token field, got', body);
	} else {
		console.log('OK:', body.length, 'API key(s), no plaintext tokens leaked');
	}
}}

### Settings - Revoke API key (nonexistent id, expect 404)
DELETE {{apiRoot}}/api/settings/api-keys/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{jwt}}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 404) {
		console.error('FAIL: expected 404 for a nonexistent API key id, got', sc, response.parsedBody);
	} else {
		console.log('OK: nonexistent API key id correctly 404s');
	}
}}

### Settings - Revoke API key
DELETE {{apiRoot}}/api/settings/api-keys/{{apiKeyId}}
Authorization: Bearer {{jwt}}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc === 404) {
		console.log('SKIP: API key id does not exist for this user (404) — set a real apiKeyId to exercise the 204 path');
	} else if (sc !== 204) {
		console.error('FAIL: expected 204 or 404, got', sc, response.parsedBody);
	} else {
		console.log('OK: API key revoked (204)');
	}
}}

### Settings - Get preferences
GET {{apiRoot}}/api/settings/preferences
Authorization: Bearer {{jwt}}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (!Array.isArray(body.available_models)) {
		console.error('FAIL: expected {preferred_model, available_models: []} shape, got', body);
	} else {
		console.log('OK: preferred_model =', body.preferred_model, '|', body.available_models.length, 'available model(s)');
	}
}}

### Settings - Update preferences
PUT {{apiRoot}}/api/settings/preferences
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"preferred_model": "anthropic.claude-sonnet-4-20250514-v1:0"
}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (body.preferred_model !== 'anthropic.claude-sonnet-4-20250514-v1:0') {
		console.error('FAIL: expected preferred_model to be updated, got', body);
	} else {
		console.log('OK: preferred_model set to', body.preferred_model);
	}
}}

