### Runs - Delete by ID
# Run LAST — deletes {{workflowId}} if it exists and you have a real jwt.
DELETE {{apiRoot}}/api/runs/{{workflowId}}
Authorization: Bearer {{jwt}}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc === 404) {
		console.log('SKIP: {{workflowId}} does not exist for this user (404)');
	} else if (sc !== 204) {
		console.error('FAIL: expected 204 or 404, got', sc, response.parsedBody);
	} else {
		console.log('OK: run deleted (204)');
	}
}}
