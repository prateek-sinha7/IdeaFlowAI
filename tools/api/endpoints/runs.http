### Runs - Artifacts by kind
GET {{apiRoot}}/api/runs/{{workflowId}}/artifacts?kind=clarifications&include=content
Authorization: Bearer {{jwt}}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc === 404) {
		console.log('SKIP: {{workflowId}} does not exist for this user (404)');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200 or 404, got', sc, body);
	} else if (!Array.isArray(body.artifacts) || !body.artifacts.every(a => a.kind === 'clarifications')) {
		console.error('FAIL: expected only kind=clarifications artifacts, got', body);
	} else {
		console.log('OK:', body.artifacts.length, 'clarifications artifact(s)');
	}
}}

