### Runs - List
GET {{apiRoot}}/api/runs?limit=20&offset=0
Authorization: Bearer {{jwt}}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ') — set a real {{jwt}} to exercise this assertion');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (!Array.isArray(body)) {
		console.error('FAIL: expected an array, got', body);
	} else {
		console.log('OK:', body.length, 'run(s)');
	}
}}

### Runs - List filtered
GET {{apiRoot}}/api/runs?type=prototype&status_filter=completed
Authorization: Bearer {{jwt}}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (!Array.isArray(body) || !body.every(r => r.type === 'prototype' && r.status === 'completed')) {
		console.error('FAIL: expected only type=prototype/status=completed runs, got', body);
	} else {
		console.log('OK:', body.length, 'completed prototype run(s)');
	}
}}

### Runs - Launch (starts a pipeline run; replaces the old WS "run_pipeline")
# Live event streaming after launch requires SSE (text/event-stream), which
# REST Client cannot consume — see tools/api/runs/*.run.http (httpyac, `SSE`
# method) for the full launch -> stream -> clarify -> completion flow.
POST {{apiRoot}}/api/runs
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"pipeline_type": "user_stories",
	"message": "Build a simple todo list app for personal task tracking."
}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, response.parsedBody);
	} else {
		console.log('OK: launched run', response.parsedBody.run_id);
	}
}}

### Runs - Events stream (SSE) -- reference only
# GET {{apiRoot}}/api/runs/{{workflowId}}/events/stream
# Authorization: Bearer {{jwt}}
# Last-Event-ID: 0
#
# text/event-stream response -- REST Client cannot consume this (no partial/
# chunked-stream support). Use tools/api/runs/*.run.http (httpyac `SSE` method)
# to actually drive this endpoint end-to-end.

### Runs - Submit clarify answers (replaces the old WS "submit_questionnaire")
POST {{apiRoot}}/api/runs/{{workflowId}}/answers
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"responses": [],
	"skip_clarification": true
}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc === 404) {
		console.log('SKIP: {{workflowId}} does not exist, or has no pending clarify gate (404)');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200 or 404, got', sc, response.parsedBody);
	} else {
		console.log('OK:', response.parsedBody);
	}
}}

### Runs - Resolve a Human_Gate review (replaces the old WS "approve_review")
POST {{apiRoot}}/api/runs/{{workflowId}}/gate
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"gate_key": "replace-with-a-real-gate-key",
	"action": "approve",
	"approved": true
}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc === 404) {
		console.log('SKIP: unknown/unowned/not-pending gate_key (404)');
	} else if (sc === 409) {
		console.log('SKIP: run is no longer running (409)');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200/404/409, got', sc, response.parsedBody);
	} else {
		console.log('OK:', response.parsedBody);
	}
}}

