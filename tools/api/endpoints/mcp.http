### MCP - JSON-RPC POST (Authorization bearer flowin API key)
POST {{apiRoot}}/mcp/handoff
Authorization: Bearer {{flowinApiKey}}
Content-Type: application/json

{
	"jsonrpc": "2.0",
	"id": 1,
	"method": "tools/list",
	"params": {}
}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401) {
		console.log('SKIP: not authenticated (401) — set a real {{flowinApiKey}} (Settings - Create API key) to exercise this assertion');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (body.jsonrpc !== '2.0' || body.id !== 1 || !Array.isArray(body.result && body.result.tools)) {
		console.error('FAIL: expected a JSON-RPC 2.0 response with result.tools as an array, got', body);
	} else {
		console.log('OK:', body.result.tools.length, 'tool(s) advertised, first =', body.result.tools[0] && body.result.tools[0].name);
	}
}}

### MCP - JSON-RPC POST (unknown method, expect a JSON-RPC error object)
# Per JSON-RPC 2.0, an unknown method is still an HTTP 200 with an error
# object in the body (code -32601), not an HTTP-level error status.
POST {{apiRoot}}/mcp/handoff
Authorization: Bearer {{flowinApiKey}}
Content-Type: application/json

{
	"jsonrpc": "2.0",
	"id": 2,
	"method": "not/a/real/method",
	"params": {}
}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401) {
		console.log('SKIP: not authenticated (401)');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200 (JSON-RPC errors are still HTTP 200), got', sc, body);
	} else if (!body.error || body.error.code !== -32601) {
		console.error('FAIL: expected a JSON-RPC error {code: -32601, message}, got', body);
	} else {
		console.log('OK: unknown method correctly returns JSON-RPC error -32601:', body.error.message);
	}
}}

### MCP - JSON-RPC POST (missing Authorization header, expect 401)
POST {{apiRoot}}/mcp/handoff
Content-Type: application/json

{
	"jsonrpc": "2.0",
	"id": 3,
	"method": "tools/list",
	"params": {}
}

{{
	if (response.statusCode !== 401) {
		console.error('FAIL: expected 401 for a missing Authorization header, got', response.statusCode, response.parsedBody);
	} else {
		console.log('OK: missing auth header correctly rejected (401)');
	}
}}

### MCP - GET stream probe (expected 405)
# Intentionally unimplemented server->client SSE stream (see mcp.py
# mcp_handoff_get docstring) — 405 is the correct, designed response.
GET {{apiRoot}}/mcp/handoff
Authorization: Bearer {{flowinApiKey}}

{{
	const sc = response.statusCode;
	if (sc === 401) {
		console.log('SKIP: not authenticated (401)');
	} else if (sc !== 405) {
		console.error('FAIL: expected 405 (GET streaming intentionally unsupported), got', sc, response.parsedBody);
	} else {
		console.log('OK: GET correctly rejected with 405 and a POST-only hint');
	}
}}
