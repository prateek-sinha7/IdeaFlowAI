### PPT - List templates
GET {{apiRoot}}/api/ppt/templates
Authorization: Bearer {{jwt}}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ') — set a real {{jwt}} to exercise this assertion');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (!Array.isArray(body) || !body.every(t => typeof t.id === 'string')) {
		console.error('FAIL: expected an array of {id, name, description, mode, ...}, got', body);
	} else {
		console.log('OK:', body.length, 'PPT/deck template(s):', body.map(t => t.id).join(', '));
	}
}}

### PPT - Get template
# guizang-ppt (magazine/editorial deck) — verified to exist in
# skills/opendesign/design-templates/ with od.mode: deck. The prior example
# id "investor-deck" does not correspond to any template directory and would
# always 404; fixed to a real one so this assertion is meaningful.
GET {{apiRoot}}/api/ppt/templates/guizang-ppt
Authorization: Bearer {{jwt}}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (body.id !== 'guizang-ppt' || typeof body.body !== 'string') {
		console.error('FAIL: expected {id, name, description, body, ...} shape, got', body);
	} else {
		console.log('OK: template', body.id, '| has_preview =', body.has_preview, '| has_thumbnail =', body.has_thumbnail);
	}
}}

### PPT - Get template (unknown id, expect 404)
GET {{apiRoot}}/api/ppt/templates/not-a-real-template-id
Authorization: Bearer {{jwt}}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 404) {
		console.error('FAIL: expected 404 for an unknown template id, got', sc, response.parsedBody);
	} else {
		console.log('OK: unknown template id correctly 404s');
	}
}}

### PPT - Template preview (public, no auth required)
# guizang-ppt has no top-level example.html (only assets/ + references/), so
# 404 ("Preview not available") is the expected, correct outcome for this
# specific template — not every ppt template has a preview.
GET {{apiRoot}}/api/ppt/templates/guizang-ppt/preview

{{
	const sc = response.statusCode;
	if (sc === 200) {
		console.log('OK: preview HTML served (200)');
	} else if (sc === 404) {
		console.log('OK: guizang-ppt has no example.html — correctly reports no preview (404)');
	} else {
		console.error('FAIL: expected 200 or 404, got', sc, response.parsedBody);
	}
}}

### PPT - Template thumbnail (public, no auth required)
# Thumbnails are generated at build time (see .gitignore's OpenDesign gallery
# thumbnail note) — 404 is expected in a dev checkout with no build step run.
GET {{apiRoot}}/api/ppt/templates/guizang-ppt/thumbnail

{{
	const sc = response.statusCode;
	if (sc === 200) {
		console.log('OK: thumbnail image served (200)');
	} else if (sc === 404) {
		console.log('OK: no pre-rendered thumbnail in this checkout — correctly reports 404');
	} else {
		console.error('FAIL: expected 200 or 404, got', sc, response.parsedBody);
	}
}}
