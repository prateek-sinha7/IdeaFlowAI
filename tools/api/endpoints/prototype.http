### Prototype - Template preview (public, no auth required)
GET {{apiRoot}}/api/prototype/templates/saas-landing/preview

{{
	const sc = response.statusCode;
	if (sc === 200) {
		console.log('OK: preview HTML served (200)');
	} else if (sc === 404) {
		console.log('NOTE: saas-landing has no example.html in this checkout — no preview (404)');
	} else {
		console.error('FAIL: expected 200 or 404, got', sc, response.parsedBody);
	}
}}

### Prototype - Template thumbnail (public, no auth required)
# Thumbnails are generated at build time (see .gitignore's OpenDesign gallery
# thumbnail note) — 404 is expected in a dev checkout with no build step run.
GET {{apiRoot}}/api/prototype/templates/saas-landing/thumbnail

{{
	const sc = response.statusCode;
	if (sc === 200) {
		console.log('OK: thumbnail image served (200)');
	} else if (sc === 404) {
		console.log('OK: no pre-rendered thumbnail in this checkout — correctly reports 404');
	} else {
		console.error('FAIL: expected 200 or 404, got', sc, response.parsedBody);
	}
}}

### Prototype - Template asset (public, no auth required)
# saas-landing has no assets/ subdirectory in this checkout (only
# example.html + SKILL.md) — 404 here is the correct, verified outcome for
# THIS template; other templates with an assets/ dir would 200.
GET {{apiRoot}}/api/prototype/templates/saas-landing/assets/template.html

{{
	const sc = response.statusCode;
	if (sc === 200) {
		console.log('OK: asset served (200)');
	} else if (sc === 404) {
		console.log('OK: saas-landing has no assets/ dir — correctly reports 404');
	} else {
