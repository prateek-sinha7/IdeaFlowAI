### Prototype - Fetch URL proxy
# Makes a REAL outbound HTTP request to the target URL (SSRF-guarded, 10s
# timeout, 2MB cap) — no agent/LLM involved, just a proxy fetch.
GET {{apiRoot}}/api/prototype/fetch-url?url=https://example.com
Authorization: Bearer {{jwt}}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc === 502 || sc === 504) {
		console.log('SKIP: upstream fetch failed (status', sc + ') — network-dependent, not a defect in this file');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (typeof body.html !== 'string') {
		console.error('FAIL: expected {html: "..."} shape, got', body);
	} else {
		console.log('OK: fetched', body.html.length, 'char(s) of HTML');
	}
}}

### Prototype - Fetch URL proxy (loopback URL, expect 400 SSRF block)
# Validation runs BEFORE the outbound request, so this is a safe, offline,
# self-contained negative test — no real request to 127.0.0.1 is made.
GET {{apiRoot}}/api/prototype/fetch-url?url=http://127.0.0.1/admin
Authorization: Bearer {{jwt}}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 400) {
		console.error('FAIL: expected 400 (SSRF guard should block a loopback URL), got', sc, response.parsedBody);
	} else {
		console.log('OK: loopback URL correctly blocked (400)');
	}
}}

### Prototype - Fetch URL proxy (bad scheme, expect 400)
GET {{apiRoot}}/api/prototype/fetch-url?url=ftp://example.com/file
Authorization: Bearer {{jwt}}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 400) {
		console.error('FAIL: expected 400 for a non-http(s) scheme, got', sc, response.parsedBody);
	} else {
		console.log('OK: non-http(s) scheme correctly rejected (400)');
	}
}}

### Prototype - Run NDJSON pipeline
# EXCLUDED from assertions: this triggers a real agent/LLM pipeline run
# (od-prototype's WS-equivalent REST flow) — out of scope for this REST-only
# test suite. Left here for manual/exploratory use only. Note the
# design_system_id below is deliberately "linear" (not "linear-app") to match
# tools/api/runs/prototype.run.http's documented finding — that value is a
# stale example carried over from before this was discovered, not touched
# here since this request itself is excluded.
POST {{apiRoot}}/api/prototype/run
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"template_id": "saas-landing",
	"design_system_id": "linear",
	"brief": "Build a focused landing page for an AI code review tool.",
	"discovery": {
		"audience": "engineering managers",
		"cta": "Start free trial"
	}
}
