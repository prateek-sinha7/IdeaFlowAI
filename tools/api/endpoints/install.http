### Install - Combined installer script
# All three install.py endpoints are public (no auth) and return
# PlainTextResponse — no request body/negative cases worth adding here.
GET {{apiRoot}}/install/flowin-handoff

{{
	const body = response.body;
	if (response.statusCode !== 200) {
		console.error('FAIL: expected 200, got', response.statusCode);
	} else if (typeof body !== 'string' || !body.includes('flowin-handoff')) {
		console.error('FAIL: expected a shell installer script mentioning flowin-handoff');
	} else {
		console.log('OK: installer script received (' + body.length + ' bytes)');
	}
}}

### Install - Slash command markdown
GET {{apiRoot}}/install/flowin-handoff/command

{{
	const body = response.body;
	if (response.statusCode !== 200) {
		console.error('FAIL: expected 200, got', response.statusCode);
	} else if (typeof body !== 'string' || body.length === 0) {
		console.error('FAIL: expected non-empty markdown content');
	} else {
		console.log('OK: slash command markdown received (' + body.length + ' bytes)');
	}
}}

### Install - Shell script
GET {{apiRoot}}/install/flowin-handoff/script

{{
	const body = response.body;
	if (response.statusCode !== 200) {
		console.error('FAIL: expected 200, got', response.statusCode);
	} else if (typeof body !== 'string' || body.length === 0) {
		console.error('FAIL: expected non-empty shell script content');
	} else {
		console.log('OK: handoff shell script received (' + body.length + ' bytes)');
	}
}}
