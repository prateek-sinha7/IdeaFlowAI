### Admin - List users
GET {{apiRoot}}/api/admin/users
Authorization: Bearer {{jwt}}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401) {
		console.log('SKIP: not authenticated (401) — set a real admin {{jwt}} to exercise this assertion');
	} else if (sc === 403) {
		console.log('SKIP: authenticated but not an admin (403) — the QA admin (qa-admin@flowinqa.com) has is_admin=True, see backend/scripts/seed_test_users.py');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (!Array.isArray(body) || !body.every(u => typeof u.is_admin === 'boolean')) {
		console.error('FAIL: expected an array of {id, email, tier, is_admin, created_at, workflow_run_count}, got', body);
	} else {
		console.log('OK:', body.length, 'user(s)');
	}
}}

### Admin - List users (non-admin token, expect 403)
# Swap {{jwt}} for a non-admin user's token (e.g. qa-basic@flowinqa.com) to
# exercise this — with the default admin {{jwt}} this will actually 200,
# which is also a valid, logged outcome below.
GET {{apiRoot}}/api/admin/users
Authorization: Bearer {{jwt}}

{{
	const sc = response.statusCode;
	if (sc === 401) {
		console.log('SKIP: not authenticated (401)');
	} else if (sc === 403) {
		console.log('OK: non-admin caller correctly rejected (403)');
	} else if (sc === 200) {
		console.log('NOTE: {{jwt}} belongs to an admin — this 200 is correct for that caller, not a failure; use a non-admin token to see the 403 path');
	} else {
		console.error('FAIL: expected 200 (admin) or 403 (non-admin), got', sc, response.parsedBody);
	}
}}

### Admin - Update user tier
PATCH {{apiRoot}}/api/admin/users/{{userId}}/tier
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"tier": "pro"
}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401) {
		console.log('SKIP: not authenticated (401)');
	} else if (sc === 403) {
		console.log('SKIP: authenticated but not an admin (403)');
	} else if (sc === 404) {
		console.log('SKIP: {{userId}} does not exist (404) — set a real user id to exercise the 200 path');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, 403, or 404, got', sc, body);
	} else if (body.tier !== 'pro') {
		console.error('FAIL: expected tier to be updated to "pro", got', body);
	} else {
		console.log('OK: user', body.id, 'tier set to', body.tier);
	}
}}

### Admin - Update user tier (invalid tier value, expect 400)
PATCH {{apiRoot}}/api/admin/users/{{userId}}/tier
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"tier": "not-a-real-tier"
}

{{
	const sc = response.statusCode;
	if (sc === 401) {
		console.log('SKIP: not authenticated (401)');
	} else if (sc === 403) {
		console.log('SKIP: authenticated but not an admin (403)');
	} else if (sc !== 400) {
		console.error('FAIL: expected 400 for an invalid tier value, got', sc, response.parsedBody);
	} else {
		console.log('OK: invalid tier value correctly rejected (400)');
	}
}}

### Admin - Create user
# Real side effect: creates a new user row every successful run. Re-running
# this exact body will 409 (duplicate email) rather than creating duplicates.
POST {{apiRoot}}/api/admin/users
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"email": "new-user@example.com",
	"password": "StrongPass123!",
	"tier": "basic",
	"is_admin": false
}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401) {
		console.log('SKIP: not authenticated (401)');
	} else if (sc === 403) {
		console.log('SKIP: authenticated but not an admin (403)');
	} else if (sc === 409) {
		console.log('OK (idempotent rerun): new-user@example.com already exists (409)');
	} else if (sc !== 201) {
		console.error('FAIL: expected 201 or 409, got', sc, body);
	} else if (body.email !== 'new-user@example.com' || body.is_admin !== false) {
		console.error('FAIL: expected the created user to echo email/is_admin, got', body);
	} else {
		console.log('OK: created user', body.id, body.email);
	}
}}

### Admin - Delete user (nonexistent id, expect 404)
DELETE {{apiRoot}}/api/admin/users/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{jwt}}

{{
	const sc = response.statusCode;
	if (sc === 401) {
		console.log('SKIP: not authenticated (401)');
	} else if (sc === 403) {
		console.log('SKIP: authenticated but not an admin (403)');
	} else if (sc !== 404) {
		console.error('FAIL: expected 404 for a nonexistent user id, got', sc, response.parsedBody);
	} else {
		console.log('OK: nonexistent user id correctly 404s');
	}
}}

### Admin - Delete user
# 400 is also a valid outcome here if {{userId}} happens to equal the calling
# admin's own id — self-delete is explicitly blocked (admin.py delete_user).
DELETE {{apiRoot}}/api/admin/users/{{userId}}
Authorization: Bearer {{jwt}}

{{
	const sc = response.statusCode;
	if (sc === 401) {
		console.log('SKIP: not authenticated (401)');
	} else if (sc === 403) {
		console.log('SKIP: authenticated but not an admin (403)');
	} else if (sc === 400) {
		console.log('OK: caller tried to delete their own admin account, correctly blocked (400)');
	} else if (sc === 404) {
		console.log('SKIP: {{userId}} does not exist (404) — set a real user id to exercise the 204 path');
	} else if (sc !== 204) {
		console.error('FAIL: expected 204, 400, 403, or 404, got', sc, response.parsedBody);
	} else {
		console.log('OK: user deleted (204)');
	}
}}
