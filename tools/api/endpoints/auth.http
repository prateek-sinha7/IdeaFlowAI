### Auth - Register (expected 403 in current config)
# Self-registration is permanently disabled server-side (account creation is
# admin-only, see backend/app/api/auth.py) — this always 403s regardless of
# auth or body, which is the behavior under test here.
POST {{apiRoot}}/api/auth/register
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"email": "user@example.com",
	"password": "StrongPass123!"
}

{{
	if (response.statusCode !== 403) {
		console.error('FAIL: expected 403 (registration disabled), got', response.statusCode, response.parsedBody);
	} else {
		console.log('OK: registration correctly disabled (403)');
	}
}}

### Auth - Login
# Uses the seeded QA admin (backend/scripts/seed_test_users.py) so this file
# is runnable out of the box against a local dev backend.
POST {{apiRoot}}/api/auth/login
Content-Type: application/json

{
	"email": "{{loginEmail}}",
	"password": "{{loginPassword}}"
}

{{
	console.clear();
	console.log("Logging in as", request.body, "...");
	if (!response.statusCode || response.statusCode < 200 || response.statusCode >= 300) {
		console.error('FAIL: login failed:', response.statusCode, response.statusText, response.parsedBody);
	} else {
		const body = response.parsedBody;
		if (typeof body.token !== 'string' || !body.user || typeof body.user.email !== 'string') {
			console.error('FAIL: expected a {token, user} shape (user with id/email/tier/is_admin), got', body);
		} else {
			console.log('OK: logged in as', body.user.email, '(tier=' + body.user.tier + ', admin=' + body.user.is_admin + ')');
		}
		// Populates {{jwt}} for every later request in THIS file's run (does not
		// carry over to other files run separately — see tools/api/runs/README.md
		// for the same pattern used there).
		exports.jwt = body.token;
	}
}}

### Auth - Login (wrong password, expect 401)
POST {{apiRoot}}/api/auth/login
Content-Type: application/json

{
	"email": "{{loginEmail}}",
	"password": "definitely-not-the-real-password"
}

{{
	if (response.statusCode !== 401) {
		console.error('FAIL: expected 401 for a wrong password, got', response.statusCode, response.parsedBody);
	} else {
		console.log('OK: wrong password correctly rejected (401)');
	}
}}

### Auth - Login (unknown email, expect 401)
# Same generic 401 as a wrong password — the endpoint deliberately does not
# distinguish "unknown email" from "wrong password" (see auth.py docstring),
# so this should produce the identical error shape as the case above.
POST {{apiRoot}}/api/auth/login
Content-Type: application/json

{
	"email": "no-such-user-ajr8f2@example.com",
	"password": "whatever123"
}

{{
	if (response.statusCode !== 401) {
		console.error('FAIL: expected 401 for an unknown email, got', response.statusCode, response.parsedBody);
	} else {
		console.log('OK: unknown email correctly rejected (401), same as a wrong password');
	}
}}

### Auth - Me
GET {{apiRoot}}/api/auth/me
Authorization: Bearer {{jwt}}
Accept: application/json

{{
	const body = response.parsedBody;
	if (response.statusCode !== 200) {
		console.error('FAIL: expected 200, got', response.statusCode, body);
	} else if (typeof body.id !== 'string' || typeof body.email !== 'string' || typeof body.is_admin !== 'boolean') {
		console.error('FAIL: expected {id, email, tier, is_admin} shape, got', body);
	} else {
		console.log('OK: me =', body.email, '(id=' + body.id + ')');
	}
}}

### Auth - Me (no Authorization header, expect 403)
# FastAPI's HTTPBearer dependency itself rejects a missing header before the
# route body ever runs — 403 "Not authenticated", NOT 401. That's a distinct
# failure mode from "present but garbage" below; both are worth asserting on
# since they're easy to conflate.
GET {{apiRoot}}/api/auth/me
Accept: application/json

{{
	if (response.statusCode !== 403) {
		console.error('FAIL: expected 403 for a missing Authorization header, got', response.statusCode, response.parsedBody);
	} else {
		console.log('OK: missing auth header correctly rejected (403)');
	}
}}

### Auth - Me (garbage token, expect 401)
# A present-but-invalid bearer token is handled inside get_current_user, which
# raises 401 "Invalid token" — distinct from the 403 above.
GET {{apiRoot}}/api/auth/me
Authorization: Bearer not-a-real-jwt
Accept: application/json

{{
	if (response.statusCode !== 401) {
		console.error('FAIL: expected 401 for a garbage token, got', response.statusCode, response.parsedBody);
	} else {
		console.log('OK: garbage token correctly rejected (401)');
	}
}}

### Auth - Change password (wrong current_password, expect 401)
# Intentionally uses a current_password that does NOT match the seeded QA
# admin's real password — this is a safe-by-default negative test, not a
# "fill in your real password" placeholder. Making it succeed would rotate
# the shared seeded QA account's password and revoke every outstanding JWT
# for it (password_changed_at blanket-revocation, see auth.py), which would
# break every other file/person relying on that seeded login. If you
# deliberately want to test a successful rotation, do it against a
# throwaway account you created via Admin - Create user, not this one.
POST {{apiRoot}}/api/auth/change-password
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"current_password": "definitely-not-the-real-password",
	"new_password": "StrongerPass456!"
}

{{
	if (response.statusCode !== 401) {
		console.error('FAIL: expected 401 (wrong current_password), got', response.statusCode, response.parsedBody);
	} else {
		console.log('OK: wrong current_password correctly rejected (401), no rotation happened');
	}
}}

### Auth - Logout
# Run this LAST — it revokes {{jwt}}, so any request after it in file order
# would then correctly get a 401 from every other dependency in this file.
POST {{apiRoot}}/api/auth/logout
Authorization: Bearer {{jwt}}

{{
	if (response.statusCode !== 204) {
		console.error('FAIL: expected 204, got', response.statusCode, response.parsedBody);
	} else {
		console.log('OK: logged out (204)');
	}
}}
