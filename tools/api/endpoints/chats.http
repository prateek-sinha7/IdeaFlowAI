### Chats - Create
POST {{apiRoot}}/api/chats
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"title": "My Chat"
}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ') — set a real {{jwt}} to exercise this assertion');
	} else if (sc !== 201) {
		console.error('FAIL: expected 201, got', sc, body);
	} else if (typeof body.id !== 'string' || body.title !== 'My Chat') {
		console.error('FAIL: expected {id, title, last_activity, created_at} shape, got', body);
	} else {
		console.log('OK: created chat', body.id);
	}
}}

### Chats - Create (no Authorization header, expect 403)
POST {{apiRoot}}/api/chats
Content-Type: application/json

{
	"title": "Should not be created"
}

{{
	if (response.statusCode !== 403) {
		console.error('FAIL: expected 403 for a missing Authorization header, got', response.statusCode, response.parsedBody);
	} else {
		console.log('OK: missing auth header correctly rejected (403)');
	}
}}

### Chats - List
GET {{apiRoot}}/api/chats
Authorization: Bearer {{jwt}}
Accept: application/json

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200, got', sc, body);
	} else if (!Array.isArray(body)) {
		console.error('FAIL: expected an array, got', body);
	} else {
		console.log('OK:', body.length, 'chat(s)');
	}
}}

### Chats - Get by ID
GET {{apiRoot}}/api/chats/{{chatId}}
Authorization: Bearer {{jwt}}
Accept: application/json

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc === 404) {
		console.log('SKIP: {{chatId}} does not exist for this user (404) — set a real chatId to exercise the 200 path');
	} else if (sc !== 200) {
		console.error('FAIL: expected 200 or 404, got', sc, body);
	} else if (!Array.isArray(body.messages)) {
		console.error('FAIL: expected {id, title, messages: [], ...} shape, got', body);
	} else {
		console.log('OK: chat', body.id, 'has', body.messages.length, 'message(s)');
	}
}}

### Chats - Get by ID (nonexistent id, expect 404)
GET {{apiRoot}}/api/chats/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{jwt}}
Accept: application/json

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc !== 404) {
		console.error('FAIL: expected 404 for a nonexistent chat id, got', sc, response.parsedBody);
	} else {
		console.log('OK: nonexistent chat id correctly 404s');
	}
}}

### Chats - Add message
PUT {{apiRoot}}/api/chats/{{chatId}}/messages
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
	"content": "Hello from api.http",
	"role": "user"
}

{{
	const body = response.parsedBody;
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc === 404) {
		console.log('SKIP: {{chatId}} does not exist for this user (404) — set a real chatId to exercise the 201 path');
	} else if (sc !== 201) {
		console.error('FAIL: expected 201 or 404, got', sc, body);
	} else if (body.role !== 'user' || body.content !== 'Hello from api.http') {
		console.error('FAIL: expected the message to be echoed back, got', body);
	} else {
		console.log('OK: message added to chat', body.chat_session_id);
	}
}}

### Chats - Delete
DELETE {{apiRoot}}/api/chats/{{chatId}}
Authorization: Bearer {{jwt}}

{{
	const sc = response.statusCode;
	if (sc === 401 || sc === 403) {
		console.log('SKIP: not authenticated (status', sc + ')');
	} else if (sc === 404) {
		console.log('SKIP: {{chatId}} does not exist for this user (404)');
	} else if (sc !== 204) {
		console.error('FAIL: expected 204 or 404, got', sc, response.parsedBody);
	} else {
		console.log('OK: chat deleted (204)');
	}
}}
